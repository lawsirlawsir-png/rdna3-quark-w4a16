@@ -291,6 +291,11 @@ __global__ void gemm_q4_kernel_rdna3(
   constexpr int LDS_PAD = 8;
   __shared__ T block_a[M_COUNT][BLOCK_KN_SIZE + LDS_PAD];
 
+  // ---- B2T (2026-09-13): 編譯期版本，熱迴圈內無執行期分支 ----
+  constexpr bool B2T = B2;
+  const int b2_gs = size_k / groups;
+  __shared__ float as_smem[M_COUNT][BLOCK_KN_SIZE / 32];
+
   // Stage A: each thread loads 1 K element per M row into LDS (with optional
   // act-order permutation). THREADS_X == BLOCK_KN_SIZE so this is a 1:1 map.
   // For M_COUNT > 1 with size_m not a multiple of M_COUNT, slots past size_m
@@ -331,6 +336,25 @@ __global__ void gemm_q4_kernel_rdna3(
     // the LDS load above — but here all THREADS_X (=256) threads always do,
     // regardless of whether their `n` is in bounds.
     __syncthreads();
+
+    if constexpr (B2T) {
+  #pragma unroll
+      for (int m = 0; m < M_COUNT; ++m) {
+  #pragma unroll
+        for (int g = 0; g < BLOCK_KN_SIZE / 32; ++g) as_smem[m][g] = 0.0f;
+      }
+      __syncthreads();
+      const int g_loc = t / b2_gs;
+      const int ng_loc = BLOCK_KN_SIZE / b2_gs;
+  #pragma unroll
+      for (int m = 0; m < M_COUNT; ++m) {
+        float v = (offset_k + t < end_k) ? (float)block_a[m][t] : 0.0f;
+  #pragma unroll
+        for (int off = 16; off > 0; off >>= 1) v += __shfl_down(v, off);
+        if ((t & 31) == 0 && g_loc < ng_loc) atomicAdd(&as_smem[m][g_loc], v);
+      }
+      __syncthreads();
+    }
   } else if (b_q_perm) {
     // bf16 M=1 fast path skips LDS, but its global read below is sequential
     // and cannot apply act-order. When a permutation is present, stage the
@@ -345,6 +369,7 @@ __global__ void gemm_q4_kernel_rdna3(
   // Group bookkeeping. We require size_k % groups == 0 (groupsize divides K).
   const int groupsize = size_k / groups;
   int group = offset_k / groupsize;
+  const int g_base = group;
   int nextgroup = (group + 1) * groupsize;
 
   // qweight stride: weights are [K/8, N] uint32 with K packed at dim 0.
@@ -405,6 +430,16 @@ __global__ void gemm_q4_kernel_rdna3(
   int k = offset_k;
   while (k < end_k) {
     if (k == nextgroup) {
+      if constexpr (B2T) {
+  #pragma unroll
+        for (int m = 0; m < M_COUNT; ++m) {
+  #pragma unroll
+          for (int col = 0; col < 4; ++col) {
+            block_c[m][col] = __fmaf_rn(z_b_f[col], as_smem[m][group - g_base],
+                                        block_c[m][col]);
+          }
+        }
+      }
       group++;
       nextgroup += groupsize;
       refresh_group(group);
@@ -563,16 +598,18 @@ __global__ void gemm_q4_kernel_rdna3(
 
         // sum_a[m] = Σ a[m][i] via 4× v_dot2 with bf162(1,1) — no fp32 widen.
         float sum_a[M_COUNT];
+        if constexpr (!B2T) {
   #pragma unroll
-        for (int m = 0; m < M_COUNT; ++m) {
-          float s = 0.0f;
+          for (int m = 0; m < M_COUNT; ++m) {
+            float s = 0.0f;
   #pragma unroll
-          for (int b = 0; b < 4; ++b) {
-            s = __builtin_amdgcn_fdot2_f32_bf16(*((bf16x2_t*)(&a_pack[m].f[b])),
-                                                *((const bf16x2_t*)&BF16_ONES),
-                                                s, /*clamp=*/false);
+            for (int b = 0; b < 4; ++b) {
+              s = __builtin_amdgcn_fdot2_f32_bf16(*((bf16x2_t*)(&a_pack[m].f[b])),
+                                                  *((const bf16x2_t*)&BF16_ONES),
+                                                  s, /*clamp=*/false);
+            }
+            sum_a[m] = s;
           }
-          sum_a[m] = s;
         }
 
         // Per col: build magic-value pack, dot against all M activations.
@@ -598,9 +635,13 @@ __global__ void gemm_q4_kernel_rdna3(
             }
             // block_c += y_b_f * partial + z_b_f * sum_a (same correction as
             // M=1)
-            block_c[m][col] =
-                __fmaf_rn(y_b_f[col], partial,
-                          __fmaf_rn(z_b_f[col], sum_a[m], block_c[m][col]));
+            if constexpr (B2T) {
+              block_c[m][col] = __fmaf_rn(y_b_f[col], partial, block_c[m][col]);
+            } else {
+              block_c[m][col] =
+                  __fmaf_rn(y_b_f[col], partial,
+                            __fmaf_rn(z_b_f[col], sum_a[m], block_c[m][col]));
+            }
           }
         }
       }
@@ -608,6 +649,17 @@ __global__ void gemm_q4_kernel_rdna3(
     k += 32;  // 4 weight words * 8 nibbles = 32 K elements
   }
 
+  if constexpr (B2T) {
+  #pragma unroll
+    for (int m = 0; m < M_COUNT; ++m) {
+  #pragma unroll
+      for (int col = 0; col < 4; ++col) {
+        block_c[m][col] = __fmaf_rn(z_b_f[col], as_smem[m][group - g_base],
+                                    block_c[m][col]);
+      }
+    }
+  }
+
   // ---- Epilogue: three store modes, selected by launch shape ----
   //
   // partials != nullptr: deterministic split-K. Plain FP32 stores to
@@ -677,7 +729,7 @@ __global__ void gemm_q4_kernel_rdna3(
 
 #else  // non-RDNA3 device pass: empty __global__ for symbol parity.
 
-template <typename T, int M_COUNT>
+template <typename T, int M_COUNT, bool B2>
 __global__ void gemm_q4_kernel_rdna3(const T*, const uint32_t*, const uint32_t*,
                                      const T*, T*, const int, const int,
                                      const int, const int, const int,
@@ -701,7 +753,18 @@ void launch_gemm_q4_for_mcount(const T* a, const uint32_t* b_q_weight,
             (size_m + M_COUNT - 1) / M_COUNT,
             (size_k + BLOCK_KN_SIZE - 1) / BLOCK_KN_SIZE);
 
-  gemm_q4_kernel_rdna3<T, M_COUNT><<<grid, block, 0, stream>>>(
+  const int b2_gs = size_k / groups;
+  const bool b2_ok = (b2_gs >= 32) && (b2_gs <= BLOCK_KN_SIZE) &&
+                     ((BLOCK_KN_SIZE % b2_gs) == 0);
+  if constexpr (std::is_same<T, __hip_bfloat16>::value && (M_COUNT > 1)) {
+    if (b2_ok) {
+      gemm_q4_kernel_rdna3<T, M_COUNT, true><<<grid, block, 0, stream>>>(
+          a, b_q_weight, b_qzeros, b_scales, c, size_m, size_n, size_k, groups,
+          zero_offset, b_q_perm, partials);
+      return;
+    }
+  }
+  gemm_q4_kernel_rdna3<T, M_COUNT, false><<<grid, block, 0, stream>>>(
       a, b_q_weight, b_qzeros, b_scales, c, size_m, size_n, size_k, groups,
       zero_offset, b_q_perm, partials);
 }
