From 23dd307878151cd9f53e345aaf8b68573f396003 Mon Sep 17 00:00:00 2001
From: lawsir <lawsir@mac-mini-hermes>
Date: Sun, 13 Sep 2026 10:38:25 +0800
Subject: [PATCH 10/19] refactor(kernel): exclude the measurement variants from
 production builds

q_gemm_rdna3_wmma.cu carried 14 SGL_WMMA_VARIANT dispatch branches (ids 16, 32,
6416, 6432, 1616, 1632, 1617, 1618, 1619, 1620, 1650, 1642, 1644, 1626) added
during the 2026-09-13 bottleneck hunt. Every one is measurement-only; none is a
production path.

They are now wrapped in #ifdef SGL_WMMA_MEASUREMENT_BENCH, so a normal build
contains none of that code and the measurement build is one flag away. The
template parameters (SFL/NT/ABL/NACC/PF) stay on the kernel signature because
their in-function branches are all if constexpr and already compile away for the
default instantiation.

Also adds a switch table to the file header (CODE-CRAFT 3): what
SGL_WMMA_KSPLIT_AUTO, SGL_WMMA_KSPLIT and SGL_WMMA_VARIANT do, their defaults,
and that the last one only exists in a measurement build.

Verified neutral: the fp64 gate returns values identical to six decimal places
to the pre-change run at every M (0.239926 / 0.263574 / 0.181686 / 0.188904).
---
 .../aot/csrc/gemm/gptq/q_gemm_rdna3_wmma.cu        | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/python/sglang/kernels/aot/csrc/gemm/gptq/q_gemm_rdna3_wmma.cu b/python/sglang/kernels/aot/csrc/gemm/gptq/q_gemm_rdna3_wmma.cu
index 9b3cff2..264bf45 100644
--- a/python/sglang/kernels/aot/csrc/gemm/gptq/q_gemm_rdna3_wmma.cu
+++ b/python/sglang/kernels/aot/csrc/gemm/gptq/q_gemm_rdna3_wmma.cu
@@ -52,6 +52,16 @@
 namespace vllm {
 namespace gptq_rdna3_wmma {
 
+// ---------------------------------------------------------------------------
+// 開關表（CODE-CRAFT §3）
+//   名稱                        預設   作用                              回滾
+//   SGL_WMMA_KSPLIT_AUTO        未設   N-aware k_split（生產必需）        移除該 env 即回舊行為
+//   SGL_WMMA_KSPLIT             0      強制 k_split 值（除錯用）           設 0
+//   SGL_WMMA_VARIANT            0      量測變體分派                        **僅在
+//                                      （需 -DSGL_WMMA_MEASUREMENT_BENCH）  量測建置中存在**
+// 生產建置不含任何量測變體程式碼；詳見 docs/KERNEL-CLEANUP-AND-GIT-HYGIENE.md
+// ---------------------------------------------------------------------------
+
 
 // Pull dequant types from the sibling namespace.
 using vllm::gptq_rdna3::bf162_t;
@@ -2403,6 +2413,9 @@ void launch_gemm_q4_wmma_64x64_4w(const T* a, const uint32_t* b_q_weight,
                                   int zero_offset, cudaStream_t stream,
                                   float* partials = nullptr,
                                   int k_split_forced = 0) {
+#ifdef SGL_WMMA_MEASUREMENT_BENCH
+  // 量測專用變體分派。預設不編譯進生產 .so（見檔頭開關表）。
+  // 要用時：重建時加 -DSGL_WMMA_MEASUREMENT_BENCH。
   // --- DSH V1 variant override (measurement only) ---
   static const int sgl_wmma_variant = []() {
     const char* e = ::getenv("SGL_WMMA_VARIANT");
@@ -2493,6 +2506,7 @@ void launch_gemm_q4_wmma_64x64_4w(const T* a, const uint32_t* b_q_weight,
     return;
   }
   // --- end DSH V1 ---
+#endif  // SGL_WMMA_MEASUREMENT_BENCH
   // Fall back to v4 when N < 64 (would waste 1+ waves on out-of-range cols).
   if (size_m < 64 || size_n < 64) {
     launch_gemm_q4_wmma_64x32_4w<T>(a, b_q_weight, b_qzeros, b_scales, b_q_perm,
