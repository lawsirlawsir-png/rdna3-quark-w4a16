+def patch_hybrid_pool_probe():
+    """【診斷】啟動時記錄 registry 內所有 token pool 嘅身份同容量。
+
+    目的：確認 scheduler 用嘅 allocator 同 target/draft 各自嘅 pool 係唔係同一個
+    物件、容量係唔係一致。HYBRID 之下兩個 route 各自 alloc_memory_pool，
+    容量唔一致 = KV 寫入越界 = CUDA illegal memory access。
+    """
+    try:
+        from sglang.srt.speculative.hybrid_controller import HybridController
+    except Exception as e:
+        logger.warning("HYBRID: pool probe import failed: %s", e)
+        return False
+    if getattr(HybridController, "_dsh_pool_probed", False):
+        return True
+
+    _orig = HybridController.init_cuda_graphs
+
+    def init_cuda_graphs(self):
+        out = _orig(self)
+        try:
+            seen = []
+            def _walk(tag, obj):
+                try:
+                    if obj is None:
+                        return
+                    _p = getattr(obj, "token_to_kv_pool", None)
+                    _a = getattr(obj, "token_to_kv_pool_allocator", None)
+                    seen.append("  %-22s pool=%-22s size=%-8s alloc=%-22s asize=%-8s" % (
+                        tag, type(_p).__name__ if _p is not None else None,
+                        int(getattr(_p, "size", -1)) if _p is not None else "-",
+                        type(_a).__name__ if _a is not None else None,
+                        int(getattr(_a, "size", -1)) if _a is not None else "-"))
+                    seen.append("  %-22s pool_id=%s alloc_id=%s" % (
+                        tag, id(_p), id(_a)))
+                except Exception as e:
+                    seen.append("  %-22s PROBE ERR %s" % (tag, e))
+
+            _tw = getattr(self, "_target_worker", None)
+            _mr = getattr(_tw, "model_runner", None)
+            _walk("target", _mr)
+            for role, w in (getattr(self, "_routes", None) or {}).items():
+                _walk(role + ".model_runner", getattr(w, "model_runner", None))
+                _dw = getattr(w, "draft_worker", None)
+                _walk(role + ".draft_worker", getattr(_dw, "model_runner", None))
+                _walk(role + ".draft_worker.tw", getattr(
+                    getattr(_dw, "target_worker", None), "model_runner", None))
+            logger.error("HYBRID-POOLS:" + chr(10) + chr(10).join(seen))
+        except Exception as e:
+            logger.error("HYBRID-POOLS probe failed: %s", e, exc_info=True)
+        return out
+
+    HybridController.init_cuda_graphs = init_cuda_graphs
+    HybridController._dsh_pool_probed = True
+    logger.error("HYBRID-POOLS: probe installed")
+    return True
