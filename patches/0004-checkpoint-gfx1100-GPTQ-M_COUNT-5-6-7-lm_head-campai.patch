diff --git a/python/sglang/srt/speculative/dsh_module_timing.py b/python/sglang/srt/speculative/dsh_module_timing.py
new file mode 100644
index 0000000..db86bf5
--- /dev/null
+++ b/python/sglang/srt/speculative/dsh_module_timing.py
@@ -0,0 +1,127 @@
+# -*- coding: utf-8 -*-
+"""Self-contained per-module GPU timing for the hybrid model (diagnostic only).
+
+Enabled with DSH_MODULE_TIMING=1.
+
+Wraps, at CLASS level, bucketed by row count and only for rows <=
+DSH_MODULE_TIMING_MAX_ROWS (default 16, so prefill cannot swamp the signal):
+
+  attn  RadixAttention              - self-attention op (attention layers)
+  gdn   Qwen3_5GatedDeltaNet        - the GDN / linear-attention op
+  linL  Qwen3_5LinearDecoderLayer   - whole linear layer (gdn + mlp + norms)
+  attL  Qwen3_5AttentionDecoderLayer- whole attention layer (attn + mlp + norms)
+
+NOTE: the model's linear layer uses Qwen3_5GatedDeltaNet for self.linear_attn,
+NOT RadixLinearAttention - wrapping the latter measures nothing.
+
+Emits RUNNING TOTALS every DSH_MODULE_TIMING_EVERY spans (default 1500) after
+one torch.cuda.synchronize(). Per-step figures are derived externally as
+total_ms / steps with steps = generated_tokens / accept_len; calls/step comes
+out at 40 (linear layers) and 16 (attention layers) as a cross-check.
+"""
+import logging
+import os
+
+import torch
+
+logger = logging.getLogger(__name__)
+
+_ENABLED = os.environ.get("DSH_MODULE_TIMING", "0") == "1"
+_EVERY = int(os.environ.get("DSH_MODULE_TIMING_EVERY", "1500"))
+_MAX_ROWS = int(os.environ.get("DSH_MODULE_TIMING_MAX_ROWS", "16"))
+_state = {"pending": [], "acc": {}, "installed": False, "logged": 0}
+
+
+def _rows(args, kwargs):
+    for a in list(args) + list(kwargs.values()):
+        try:
+            if hasattr(a, "shape") and len(a.shape) >= 2:
+                return int(a.shape[0])
+            if isinstance(a, (list, tuple)) and len(a) > 0 and hasattr(a[0], "shape"):
+                return int(a[0].shape[0])
+        except Exception:
+            continue
+    return -1
+
+
+def _drain():
+    pend = _state["pending"]
+    if len(pend) < _EVERY:
+        return
+    try:
+        torch.cuda.synchronize()
+    except Exception:
+        pass
+    acc = _state["acc"]
+    for name, e0, e1 in pend:
+        try:
+            ms = e0.elapsed_time(e1)
+        except Exception:
+            ms = 0.0
+        a = acc.setdefault(name, [0.0, 0])
+        a[0] += ms
+        a[1] += 1
+    pend.clear()
+    _state["logged"] += 1
+    logger.error(
+        "DSH-MODTIMING totals#%d: %s",
+        _state["logged"],
+        " | ".join(
+            "%s sum=%.1fms n=%d" % (k, v[0], v[1]) for k, v in sorted(acc.items())
+        ),
+    )
+
+
+def _wrap(cls, name):
+    orig = getattr(cls, "forward", None)
+    if orig is None:
+        return False
+
+    def forward(self, *args, **kwargs):
+        rows = _rows(args, kwargs)
+        if rows < 0 or rows > _MAX_ROWS:
+            return orig(self, *args, **kwargs)
+        tag = "%s_r%d" % (name, 1 if rows <= 2 else rows)
+        e0 = torch.cuda.Event(enable_timing=True)
+        e0.record()
+        out = orig(self, *args, **kwargs)
+        e1 = torch.cuda.Event(enable_timing=True)
+        e1.record()
+        _state["pending"].append((tag, e0, e1))
+        _drain()
+        return out
+
+    forward.__name__ = getattr(orig, "__name__", "forward")
+    cls.forward = forward
+    return True
+
+
+def install():
+    if not _ENABLED:
+        return False
+    if _state["installed"]:
+        return True
+    done = []
+    try:
+        from sglang.srt.layers.radix_attention import RadixAttention
+        if _wrap(RadixAttention, "attn"):
+            done.append("attn")
+    except Exception as e:
+        logger.warning("DSH-MODTIMING: radix_attention import failed: %s", e)
+    try:
+        from sglang.srt.models.qwen3_5 import (
+            Qwen3_5AttentionDecoderLayer,
+            Qwen3_5GatedDeltaNet,
+            Qwen3_5LinearDecoderLayer,
+        )
+        if _wrap(Qwen3_5GatedDeltaNet, "gdn"):
+            done.append("gdn")
+        if _wrap(Qwen3_5LinearDecoderLayer, "linL"):
+            done.append("linL")
+        if _wrap(Qwen3_5AttentionDecoderLayer, "attL"):
+            done.append("attL")
+    except Exception as e:
+        logger.warning("DSH-MODTIMING: qwen3_5 import failed: %s", e)
+    _state["installed"] = True
+    logger.error("DSH-MODTIMING: installed %s (rows<=%d every=%d)" % (done, _MAX_ROWS, _EVERY))
+    return bool(done)
