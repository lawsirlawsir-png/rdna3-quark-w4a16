@@ -0,0 +1,52 @@
+# -*- coding: utf-8 -*-
+"""註冊 HYBRID 算法（供 spec_registry 延遲載入呼叫）。"""
+import logging
+import os
+
+logger = logging.getLogger(__name__)
+_DONE = False
+_LOADING = False
+
+
+def ensure_registered():
+    global _DONE, _LOADING
+    if _DONE:
+        # 即使已註冊，仍要確保 spec 物件嘅 target-verify 寬度被修正
+        try:
+            from sglang.srt.speculative import hybrid_patches as _hp0
+            _hp0.patch_hybrid_spec_object()
+        except Exception:
+            pass
+        return True
+    if _LOADING:          # reentrancy guard: get_spec -> here -> get_spec ...
+        return False
+    _LOADING = True
+    try:
+        from sglang.srt.speculative.spec_registry import _REGISTRY
+    except Exception as e:
+        logger.warning("HYBRID register: import failed: %s", e)
+        _LOADING = False
+        return False
+    if _REGISTRY.get("HYBRID") is not None:
+        _DONE = True
+        _LOADING = False
+        return True
+    try:
+        from sglang.srt.speculative import hybrid_controller as _hc
+        _hc.register()
+        from sglang.srt.speculative import hybrid_patches as _hp
+        _hp.apply_all()
+        _hp.patch_hybrid_spec_object()
+        _DONE = True
+        _LOADING = False
+        logger.info("HYBRID: registered + patches applied")
+        return True
+    except Exception as e:
+        logger.warning("HYBRID ensure_registered failed: %s", e)
+        _LOADING = False
+        return False
+
+# 匯入即註冊（只在 DSH_HYBRID=1 時）
+if os.environ.get("DSH_HYBRID", "0") == "1":
+    ensure_registered()
+_AUTORUN = True
