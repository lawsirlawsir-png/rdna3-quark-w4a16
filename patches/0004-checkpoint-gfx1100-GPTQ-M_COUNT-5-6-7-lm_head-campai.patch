+def patch_kv_write_forensics():
+    """KV 寫入取證：記錄所有寫入路徑嘅 loc 範圍（含 draft 嘅 prefix-valid）。"""
+    try:
+        from sglang.srt.mem_cache import memory_pool as _mp
+    except Exception as e:
+        logger.warning("HYBRID: forensics import failed: %s", e)
+        return False
+    if getattr(_mp.MHATokenToKVPool, "_dsh_forensics", False):
+        return True
+    import traceback as _tb
+    import os as _os
+    LOG = _os.path.expanduser("~/kv_forensics.log")
+    NL = chr(10)
+
+    def _record(kind, loc, lo, hi, extra=""):
+        try:
+            if loc is None or not hasattr(loc, "numel") or loc.numel() == 0:
+                return
+            mn = int(loc.min().item())
+            mx = int(loc.max().item())
+            bad = (mn < lo) or (mx >= hi)
+            with open(LOG, "a") as f:
+                if bad:
+                    f.write(NL + "==== VIOLATION %s loc=[%d,%d] allowed=[%d,%d) %s" % (kind, mn, mx, lo, hi, extra) + NL)
+                    f.write("".join(_tb.format_stack()[-18:]) + NL)
+                else:
+                    f.write("[%s] ok loc=[%d,%d] allowed=[%d,%d) %s" % (kind, mn, mx, lo, hi, extra) + NL)
+        except Exception:
+            pass
+
+    _orig_sb = _mp.MHATokenToKVPool.set_kv_buffer
+    _orig_pv = _mp.MHATokenToKVPool.set_kv_buffer_prefix_valid
+
+    def set_kv_buffer(self, layer, loc_info, cache_k, cache_v, *a, **kw):
+        try:
+            _record("MHA.set_kv_buffer", _mp.unwrap_write_loc(loc_info)[0],
+                    0, int(self.size) + int(self.page_size),
+                    "layer=%s" % getattr(layer, "layer_id", "?"))
+        except Exception:
+            pass
+        return _orig_sb(self, layer, loc_info, cache_k, cache_v, *a, **kw)
+
+    def set_kv_buffer_prefix_valid(self, layer, loc_2d, commit_lens,
+                                   cache_k, cache_v, *a, **kw):
+        try:
+            _record("MHA.prefix_valid", loc_2d, 0,
+                    int(self.size) + int(self.page_size),
+                    "layer=%s rows=%s" % (getattr(layer, "layer_id", "?"),
+                                          int(loc_2d.numel())))
+            with open(LOG, "a") as f:
+                f.write("      commit_lens=" + str(commit_lens.tolist() if hasattr(commit_lens, "tolist") else commit_lens) + NL)
+        except Exception:
+            pass
+        return _orig_pv(self, layer, loc_2d, commit_lens, cache_k, cache_v, *a, **kw)
+
+    _mp.MHATokenToKVPool.set_kv_buffer = set_kv_buffer
+    _mp.MHATokenToKVPool.set_kv_buffer_prefix_valid = set_kv_buffer_prefix_valid
+    _mp.MHATokenToKVPool._dsh_forensics = True
+    try:
+        with open(LOG, "w") as f:
+            f.write("KV forensics started" + NL)
+    except Exception:
+        pass
+    logger.error("HYBRID-FORENSICS: KV write forensics installed -> %s", LOG)
+    return True
