+def patch_graph_spec_info_for_hybrid():
+    """【轉換層 · 關鍵】為 HYBRID 補上 graph 捕捉期嘅 spec_info。
+
+    decode_cuda_graph_runner.get_spec_info() 只處理 is_eagle()/is_standalone()，
+    HYBRID 兩者皆非 ⇒ spec_info 回 None ⇒ target verify CUDA graph 捕捉時
+    GDN/Mamba backend 讀 forward_batch.spec_info.draft_token_num 爆
+    (AttributeError)。喺此為 HYBRID 補上 DFLASHVerifyInput。
+    """
+    try:
+        from sglang.srt.model_executor.runner.decode_cuda_graph_runner import (
+            DecodeCudaGraphRunner,
+        )
+    except Exception as e:
+        logger.warning("HYBRID: get_spec_info patch import failed: %s", e)
+        return False
+    if getattr(DecodeCudaGraphRunner, "_dsh_spec_info_patched", False):
+        return True
+    if not hasattr(DecodeCudaGraphRunner, "get_spec_info"):
+        DecodeCudaGraphRunner._dsh_spec_info_patched = True
+        logger.info("HYBRID-GRAPH: no DecodeCudaGraphRunner.get_spec_info "
+                    "(upstream build?) -> skipped, no-op")
+        return True
+
+    _orig = DecodeCudaGraphRunner.get_spec_info
+
+    def get_spec_info(self, num_tokens):
+        info = _orig(self, num_tokens)
+        if info is not None:
+            return info
+        try:
+            sa = self.model_runner.spec_algorithm
+            if not getattr(sa, "is_hybrid", None) or not sa.is_hybrid():
+                return None
+            from sglang.srt.speculative.dflash_info import DFlashVerifyInput
+            width = int(self.captured_req_width or 0) or int(
+                get_spec().speculative_num_draft_tokens or 8)
+            bs = max(1, int(self.captured_bs or 1))
+            dev = self.model_runner.device
+            import torch as _t
+            info = DFlashVerifyInput(
+                draft_token=_t.zeros(bs * width, dtype=_t.int64, device=dev),
+                positions=_t.zeros(bs * width, dtype=_t.int64, device=dev),
+                draft_token_num=width,
+                custom_mask=None,
+            )
+            logger.error(
+                "HYBRID-GRAPH: get_spec_info built DFlashVerifyInput "
+                "bs=%s width=%s num_tokens=%s", bs, width, num_tokens)
+            return info
+        except Exception as e:
+            logger.warning("HYBRID: get_spec_info hybrid branch failed: %s", e)
+            return None
+
+    DecodeCudaGraphRunner.get_spec_info = get_spec_info
+    DecodeCudaGraphRunner._dsh_spec_info_patched = True
+    logger.error("HYBRID-GRAPH: get_spec_info patched for HYBRID")
+    return True
+
