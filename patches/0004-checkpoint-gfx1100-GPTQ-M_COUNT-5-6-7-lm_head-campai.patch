+# -*- coding: utf-8 -*-
+"""HYBRID verify-input 狀態隔離（DFLASH 版，原創）。
+
+架構參考：sgl-project/sglang PR #37237 hybrid_info.py（EAGLE 版）。
+差異：我哋 neural route 係 DFLASH（block-diffusion），唔係 EAGLE3。
+
+【為何需要】兩個 route 共用同一個 target model object；若共用同一份 verify
+state / buffer 分配，neural（DFLASH, width=8, 5 層 aux）同 retrieval
+（NGRAM, width=12, 樹狀）嘅尺寸假設會互相污染，導致 CUDA illegal memory
+access。
+
+【轉換】唔融合兩者，而係造一層 wrapper 同時持有兩個原生 input，只代理
+共用嘅生命週期（同上游做法一致）。
+"""
+from __future__ import annotations
+
+from typing import Optional
+
+import torch
+
+from sglang.srt.speculative.spec_info import SpecInput, SpecInputType
+
+
+class HybridVerifyInput(SpecInput):
+    """同時持有 neural（DFLASH）同 retrieval（NGRAM）嘅原生 state。
+
+    兩邊各自保留自己嘅類型；切換 route 時只需揀對應嘅一個，唔會將另一方
+    嘅欄位灌入去。
+    """
+
+    def __init__(self, neural_input, retrieval_input) -> None:
+        super().__init__(SpecInputType.HYBRID_VERIFY)
+        self.neural_input = neural_input
+        self.retrieval_input = retrieval_input
+        self.active = "neural"
+
+    def pick(self, route: str):
+        self.active = route
+        return self.neural_input if route == "neural" else self.retrieval_input
+
+    @property
+    def future_indices(self) -> Optional[torch.Tensor]:
+        cur = self.neural_input if self.active == "neural" else self.retrieval_input
+        return getattr(cur, "future_indices", None)
+
+    @future_indices.setter
+    def future_indices(self, value) -> None:
+        for inp in (self.neural_input, self.retrieval_input):
+            if inp is None:
+                continue
+            try:
+                inp.future_indices = value
+            except Exception:
+                pass
+
+    def filter_batch(self, new_indices, new_indices_cpu=None) -> None:
+        for inp in (self.neural_input, self.retrieval_input):
+            if inp is None:
+                continue
+            fn = getattr(inp, "filter_batch", None)
+            if fn is None:
+                continue
+            try:
+                fn(new_indices, new_indices_cpu)
+            except TypeError:
+                fn(new_indices)
+
+    def merge_batch(self, spec_info) -> None:
+        if not isinstance(spec_info, HybridVerifyInput):
+            raise TypeError(
+                "HybridVerifyInput can only merge another HybridVerifyInput."
+            )
+        for a, b in (
+            (self.neural_input, spec_info.neural_input),
+            (self.retrieval_input, spec_info.retrieval_input),
+        ):
+            if a is None or b is None:
+                continue
+            fn = getattr(a, "merge_batch", None)
+            if fn is not None:
+                fn(b)
