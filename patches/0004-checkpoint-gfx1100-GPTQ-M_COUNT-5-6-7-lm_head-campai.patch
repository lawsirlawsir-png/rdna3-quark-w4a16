+def patch_hybrid_contract_autodelegate():
+    """【契約層】BaseSpecWorker 嘅成員，HybridController 缺邊個就自動委派去 neural。
+
+    避免逐個補（已撞過 preloaded_weights_bytes / init_hicache_draft_plan）。
+    """
+    try:
+        from sglang.srt.speculative.base_spec_worker import BaseSpecWorker
+        from sglang.srt.speculative.hybrid_controller import HybridController
+    except Exception as e:
+        logger.warning("HYBRID: autodelegate import failed: %s", e)
+        return False
+    if getattr(HybridController, "_dsh_autodelegate", False):
+        return True
+
+    def _candidates(self):
+        out = []
+        n = getattr(self, "neural_worker", None)
+        r = getattr(self, "retrieval_worker", None)
+        if n is not None:
+            out.append(n)
+        if r is not None:
+            out.append(r)
+        return out
+
+    def _pick(self):
+        return getattr(self, "neural_worker", None)
+
+    added = []
+    for name in dir(BaseSpecWorker):
+        if name.startswith("__") or name.startswith("_draft"):
+            continue
+        if hasattr(HybridController, name):
+            continue
+        base_attr = getattr(BaseSpecWorker, name, None)
+        try:
+            if isinstance(base_attr, property):
+                def _mk(nm):
+                    def _get(self):
+                        # 安全委托：worker 冇該屬性（或其 __getattr__ 拋錯）時回 None，
+                        # 唔好令 scheduler 初始化路徑爆 AttributeError。
+                        for w in _candidates(self):
+                            try:
+                                return getattr(w, nm)
+                            except Exception:
+                                continue
+                        return None
+                    return property(_get)
+                setattr(HybridController, name, _mk(name))
+                added.append(name + "(prop)")
+            elif callable(base_attr):
+                def _mkm(nm):
+                    def _call(self, *a, **kw):
+                        w = _pick(self)
+                        fn = getattr(w, nm, None)
+                        if fn is None:
+                            return None
+                        return fn(*a, **kw)
+                    return _call
+                setattr(HybridController, name, _mkm(name))
+                added.append(name + "(meth)")
+        except Exception as e:
+            logger.warning("HYBRID: autodelegate %s failed: %s", name, e)
+
+    HybridController._dsh_autodelegate = True
+    if added:
+        logger.info("HYBRID[契約層]: auto-delegated %d members: %s",
+                    len(added), added[:14])
+    return True
+
