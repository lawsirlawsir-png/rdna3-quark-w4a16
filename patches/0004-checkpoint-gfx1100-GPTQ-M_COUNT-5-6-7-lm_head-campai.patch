+def patch_hybrid_target_verify_width():
+    """【轉換層】HYBRID 嘅 target-verify 寬度必須跟 route，唔可以一律用最寬值。
+
+    spec_utils.resolve_num_tokens_per_req(phase="target_verify") 會呼叫
+    spec_algorithm.get_num_tokens_per_req_for_target_verify(num_draft_tokens,
+    is_draft_worker)；HYBRID 之下 num_draft_tokens = 最寬 route（NGRAM=12），
+    但 DFLASH 嘅 verify 寬度係 8（block_size）⇒ target verify CUDA graph 會以
+    12 捕捉，而 GDN/Mamba backend 靠 spec_info.draft_token_num 切 batch，
+    捕捉期 spec_info 為 None 且寬度不符 ⇒ AttributeError。
+    """
+    try:
+        from sglang.srt.speculative.hybrid_controller import HybridController
+    except Exception as e:
+        logger.warning("HYBRID: width-hook import failed: %s", e)
+        return False
+    if getattr(HybridController, "_dsh_width_patched", False):
+        return True
+
+    def get_num_tokens_per_req_for_target_verify(
+        self, num_draft_tokens, is_draft_worker
+    ):
+        # 只有 neural route 會行 target verify；用佢自己嘅寬度。
+        try:
+            w = getattr(self, "_width", None)
+            nw = (w or {}).get("neural") if w else None
+            logger.error(
+                "HYBRID-GRAPH: width hook CALLED num_draft_tokens=%s "
+                "is_draft_worker=%s _width=%s -> returning %s",
+                num_draft_tokens, is_draft_worker, w, nw or "num_draft_tokens",
+            )
+            if nw:
+                return int(nw)
+        except Exception as e:
+            logger.error("HYBRID-GRAPH: width hook error %s", e)
+        return int(num_draft_tokens)
+
+    HybridController.get_num_tokens_per_req_for_target_verify = (
+        get_num_tokens_per_req_for_target_verify
+    )
+    HybridController._dsh_width_patched = True
+    logger.error("HYBRID-GRAPH: target-verify width hook installed")
+    return True
+
