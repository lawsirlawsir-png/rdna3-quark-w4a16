+def patch_hybrid_prepare_for_decode():
+    """【轉換層 · 關鍵】HYBRID 之下 decode 前準備必須用 route 自己嘅 block_size。
+
+    機轉：scheduler.update_running_batch -> batch.prepare_for_decode ->
+    spec_utils.spec_prepare_for_decode()：
+
+        if batch.spec_algorithm.is_dflash_family():
+            batch.spec_info.prepare_for_decode(batch)      # <- DFLASH 分支
+        else:
+            eagle_prepare_for_decode(batch)                # <- NGRAM 走呢邊
+
+    HYBRID 宣告咗 is_dflash_family()=True（5 層 aux 捕捉需要），所以永遠行
+    DFLASH 分支。但 DFlashDraftInputV2.prepare_for_decode 內部係：
+
+        block_size = int(get_spec().speculative_num_draft_tokens)   # <-- 讀全局 spec bag
+        reserve = 2 * block_size
+
+    HYBRID 之下全局 spec bag 係 NGRAM 嘅 12（最寬 route），而 DFLASH 實際
+    block_size 係 8 ⇒ reserve 由 16 變 24 ⇒ 預留 KV 槽位同 worker 實際使用唔一致。
+    DFLASH 嘅 v2 worker 係「超額預留 + 直接由 req_to_token 取 out_cache_loc」
+    設計（無 allocator 備份／還原），一致受到破壞即令 verify 讀到錯誤 KV 位置
+    ⇒ CUDA illegal memory access（症狀：target verify 內 torch.empty_like(q) 爆）。
+
+    同時 NGRAM route 嘅 NgramVerifyInput 冇 prepare_for_decode ⇒ 強制 retrieval
+    時會 AttributeError。故此呢個 hook 同時處理兩個 route。
+    """
+    try:
+        from sglang.srt.speculative import spec_utils as _su
+    except Exception as e:
+        logger.warning("HYBRID: prepare_for_decode import failed: %s", e)
+        return False
+    if getattr(_su, "_dsh_hybrid_pfd", False):
+        return True
+
+    def spec_prepare_for_decode(batch):
+        try:
+            w = getattr(type(batch.spec_algorithm), "_dsh_widths", None)
+            if w is None:
+                from sglang.srt.speculative import hybrid_controller as _hc2
+                w = getattr(_hc2, "ROUTE_WIDTHS", None)
+            neural_w = int((w or {}).get("neural", 0) or 0)
+        except Exception:
+            neural_w = 0
+
+        spec_info = getattr(batch, "spec_info", None)
+        if spec_info is None:
+            return
+        _tn = type(spec_info).__name__
+        _is_neural = _tn.startswith("DFlash") or _tn.startswith("DSpark")
+
+        import contextlib
+        with contextlib.ExitStack() as stack:
+            if neural_w > 0:
+                try:
+                    from sglang.srt.runtime_context import get_context
+                    stack.enter_context(
+                        get_context().config_bag("spec").override(
+                            speculative_num_draft_tokens=neural_w))
+                except Exception as e:
+                    logger.warning("HYBRID: pfd spec override failed: %s", e)
+
+            if _is_neural:
+                fn = getattr(spec_info, "prepare_for_decode", None)
+                if fn is None:
+                    logger.error("HYBRID: neural spec_info %s lacks "
+                                 "prepare_for_decode", _tn)
+                    return
+                fn(batch)
+            else:
+                # retrieval（NGRAM）：原生路徑係 eagle_prepare_for_decode
+                from sglang.srt.speculative.eagle_utils import (
+                    eagle_prepare_for_decode,
+                )
+                eagle_prepare_for_decode(batch)
+
+    _su.spec_prepare_for_decode = spec_prepare_for_decode
+    _su._dsh_hybrid_pfd = True
+    logger.error("HYBRID-SEAM: spec_prepare_for_decode patched (route-aware block size)")
+    return True
+
+def patch_rdna_verify_width():
+    """【轉換層】RDNA unified verify kernel 嘅 num_draft_tokens 必須跟 route。
+
+    triton_backend.__init__ 做 self.num_draft_tokens =
+    get_spec().speculative_num_draft_tokens —— HYBRID 之下呢個係全局 spec bag
+    值（最寬 route = NGRAM 12），但 neural（DFLASH）route 每 request 只驗 8 行。
+    _rdna_unified_verify 直接攞 self.num_draft_tokens 去起 RdnaVerifyBuffers
+    同計 qo_indptr stride ⇒ kernel 以 12 行處理 8 行 ⇒ 讀到未配置記憶體
+    ⇒ CUDA illegal memory access（fault 位置浮動，常見於 torch.empty_like）。
+
+    上游自己喺 triton_backend.py:644/985 已有「spec_info.draft_token_num 優先」
+    嘅寫法；呢度按同一 pattern 補上，並將 scratch buffer 按寬度分開快取，
+    令兩個 route 可以共存。
+    """
+    try:
+        from sglang.srt.layers.attention.triton_backend import TritonAttnBackend
+    except Exception as e:
+        logger.warning("HYBRID: rdna width import failed: %s", e)
+        return False
+    if getattr(TritonAttnBackend, "_dsh_rdna_width_patched", False):
+        return True
+
+    # 【通用性】RDNA unified verify 係本 fork vendored 嘅 RDNA 專屬路徑
+    # （env SGL_RDNA_VLLM_VERIFY 開啟；架構 gate 接受 gfx95 / gfx110* / gfx115*）。
+    # 上游 SGLang 或其他平台冇呢個方法 ⇒ 乾淨 skip（唔算失敗、唔應報 warning）。
+    if not hasattr(TritonAttnBackend, "_rdna_unified_verify"):
+        TritonAttnBackend._dsh_rdna_width_patched = True
+        logger.info(
+            "HYBRID-RDNA: TritonAttnBackend has no _rdna_unified_verify "
+            "(non-RDNA platform or upstream build) -> skipped, no-op")
+        return True
+
+    _orig = TritonAttnBackend._rdna_unified_verify
+
+    def _rdna_unified_verify(self, q, o, layer, forward_batch, kv_indptr,
+                             kv_indices, logits_soft_cap, skip_fill=False,
+                             extend_meta=None):
+        spec_info = getattr(forward_batch, "spec_info", None)
+        width = None
+        try:
+            _dn = getattr(spec_info, "draft_token_num", None)
+            if _dn is not None:
+                width = int(_dn)
+        except Exception:
+            width = None
+        if width is None:
+            width = int(self.num_draft_tokens)
+            # 【關鍵】spec_info 冇 draft_token_num（例：EagleDraftInput）時，
+            # 必須 fallback 去 neural 寬度，唔可以跌落全局 self.num_draft_tokens
+            # （HYBRID 之下 = 最寬 route = NGRAM 12）=> kernel 越界。
+            try:
+                from sglang.srt.speculative.hybrid_controller import NEURAL_WIDTH
+                nw = NEURAL_WIDTH.get("neural")
+                if nw:
+                    width = int(nw)
+            except Exception:
+                pass
+            logger.error("HYBRID-RDNA: no native draft_token_num; fallback neural width=%d (global=%d)", width, int(self.num_draft_tokens))
+        # 依該寬度選／建 scratch（原本係單一實例 + 寬度固定）
+        try:
+            bufs = getattr(self, "_dsh_rdna_bufs_by_width", None)
+            if bufs is None:
+                bufs = {}
+                self._dsh_rdna_bufs_by_width = bufs
+            if width not in bufs:
+                from sglang.kernels.ops.attention.rdna_verify_adapter import (
+                    RdnaVerifyBuffers,
+                )
+                bufs[width] = RdnaVerifyBuffers(
+                    device=q.device,
+                    max_bs=64,
+                    max_pages=self.max_context_len + 32,
+                    num_draft_tokens=width,
+                    h_q=q.shape[1],
+                    head_dim=q.shape[2],
+                    block_q=16 // (q.shape[1] // self.token_to_kv_pool.get_key_buffer(
+                        layer.layer_id).shape[1]),
+                    segments=32,
+                )
+                logger.error("HYBRID-RDNA: built verify buffers width=%d (bs=%d)",
+                             width, len(bufs))
+            self.rdna_verify_bufs = bufs[width]
+        except Exception as e:
+            logger.error("HYBRID-RDNA: buffer selection failed: %s", e, exc_info=True)
+        return _orig(self, q, o, layer, forward_batch, kv_indptr, kv_indices,
+                     logits_soft_cap, skip_fill=skip_fill, extend_meta=extend_meta)
+
+    TritonAttnBackend._rdna_unified_verify = _rdna_unified_verify
+    TritonAttnBackend._dsh_rdna_width_patched = True
+    logger.error("HYBRID-RDNA: verify kernel width made route-aware")
+    return True
+
+
+def patch_eagle_worker_width():
+    """【轉換層】EAGLE worker 嘅 speculative_num_draft_tokens 必須跟 neural route。
+
+    eagle_worker_v2.py:194 同 :1197 都做：
+        self.speculative_num_draft_tokens = get_spec().speculative_num_draft_tokens
+    HYBRID 之下 get_spec() 係全局 spec bag（最寬 route = NGRAM 12），
+    而 EAGLE 實際每 request 只驗 steps+1 = 4 行 => RDNA verify kernel 越界
+    （實測 HYBRID-RDNA: built verify buffers width=12 之後即 hipErrorIllegalAddress）。
+
+    等價於上游 triton_backend.py:644/985 嘅 native 優先 pattern。
+    """
+    try:
+        from sglang.srt.speculative import eagle_worker_v2 as _ew
+    except Exception as e:
+        logger.warning("HYBRID: eagle width import failed: %s", e)
+        return False
+    if getattr(_ew, "_dsh_eagle_width_patched", False):
+        return True
+
+    def _neural_num_draft_tokens(default):
+        try:
+            from sglang.srt.speculative.hybrid_controller import NEURAL_WIDTH
+            nw = NEURAL_WIDTH.get("neural")
+            if nw:
+                return int(nw)
+        except Exception:
+            pass
+        return default
+
+    import re as _re
+    src_path = _ew.__file__
+    try:
+        _src = open(src_path, encoding="utf-8").read()
+    except Exception as e:
+        logger.warning("HYBRID: cannot read eagle_worker_v2: %s", e)
+        return False
+
+    _old = "self.speculative_num_draft_tokens = get_spec().speculative_num_draft_tokens"
+    _new = ("self.speculative_num_draft_tokens = _dsh_neural_ndt("
+            "get_spec().speculative_num_draft_tokens)")
+    n = _src.count(_old)
+    if n == 0:
+        logger.error("HYBRID: eagle width anchor not found")
+        return False
+    _src = _src.replace(_old, _new)
+    _src = _src + _HELPER_SRC
+    try:
+        import ast as _ast
+        _ast.parse(_src)
+    except SyntaxError as e:
+        logger.error("HYBRID: eagle width patch would break syntax: %s", e)
+        return False
+    open(src_path, "w", encoding="utf-8").write(_src)
+    _ew._dsh_eagle_width_patched = True
+    logger.error("HYBRID-EAGLE: %d num_draft_tokens site(s) made neural-aware", n)
+    return True
+
+
+# DSH diagnostic hook: per-module GPU timing (no-op unless DSH_MODULE_TIMING=1)
+try:
+    from sglang.srt.speculative import dsh_module_timing as _dsdmt
+    _dsdmt.install()
+except Exception:
+    pass
