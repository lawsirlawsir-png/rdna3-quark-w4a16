+def patch_ngram_worker():
+    """為 NGRAMWorker 補 get_retrieval_info + step 記錄。"""
+    from sglang.srt.speculative.ngram_worker import NGRAMWorker
+    if getattr(NGRAMWorker, "_dsh_hybrid_patched", False):
+        return True
+
+    import numpy as np
+
+    _orig_fbg = NGRAMWorker.forward_batch_generation
+
+    def _fbg(self, batch, on_publish=None, pp_proxy_tensors=None):
+        self._dsh_retrieval_batch = batch
+        return _orig_fbg(self, batch, on_publish=on_publish,
+                         pp_proxy_tensors=pp_proxy_tensors)
+
+    def get_retrieval_info(self, batch):
+        """回傳 (continuation_lens, suffix_match_lens)，每個 request 一個值。
+
+        mask 語義：shape (bs*dtn, dtn)；第 0 行嘅前 k 個 1 = 線性前綴長度 k，
+        代表引擎由 anchor 延伸出嘅候選鏈長度。
+        """
+        try:
+            dtn = int(self.draft_token_num)
+            depth = int(self.max_trie_depth)
+            reqs = list(batch.reqs)
+            bs = len(reqs)
+            if bs == 0:
+                return None
+            req_ids = [r.rid for r in reqs]
+            tails = [list(r.origin_input_ids[-depth:]) +
+                     list(r.output_ids[-depth:]) for r in reqs]
+            tails = [t[-depth:] for t in tails]
+            base_lens = [len(r.origin_input_ids) + len(r.output_ids) for r in reqs]
+            keep = [i for i, t in enumerate(tails) if t]
+            if not keep:
+                return None
+            self.ngram_corpus.batch_put([tails[i] for i in keep])
+            self.ngram_corpus.synchronize()
+            ids, mask = self.ngram_corpus.batch_get(
+                [req_ids[i] for i in keep], [tails[i] for i in keep],
+                [base_lens[i] for i in keep])
+            ids = np.asarray(ids).ravel()
+            mask = np.asarray(mask).ravel()
+            conts = [0] * bs
+            matches = [0] * bs
+            for row, i in enumerate(keep):
+                seg = ids[row * dtn:(row + 1) * dtn]
+                mseg = mask[row * dtn * dtn:(row + 1) * dtn * dtn]
+                conts[i] = int((seg != 0).sum())
+                if mseg.size >= dtn:
+                    row0 = mseg[:dtn]
+                    k = 0
+                    while k < dtn and row0[k] == 1:
+                        k += 1
+                    matches[i] = k
+            return conts, matches
+        except Exception as e:
+            logger.warning("get_retrieval_info failed: %s", e)
+            return None
+
+    NGRAMWorker.forward_batch_generation = _fbg
+    NGRAMWorker.get_retrieval_info = get_retrieval_info
+    NGRAMWorker._dsh_hybrid_patched = True
+    logger.info("HYBRID: NGRAMWorker patched (get_retrieval_info)")
+    return True
+
