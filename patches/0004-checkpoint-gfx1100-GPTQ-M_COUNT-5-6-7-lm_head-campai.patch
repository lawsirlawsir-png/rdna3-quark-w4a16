+
+    def graph_time_usage(self):
+        out = {}
+        for role, w in self._routes.items():
+            try:
+                d = w.graph_time_usage
+                if isinstance(d, dict):
+                    out.update({("%s.%s" % (role, k)): v for k, v in d.items()})
+            except Exception:
+                pass
