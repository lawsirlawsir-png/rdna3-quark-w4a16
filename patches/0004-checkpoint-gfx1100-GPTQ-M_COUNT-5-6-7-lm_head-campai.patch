@@ -0,0 +1,120 @@
+# -*- coding: utf-8 -*-
+"""NGRAM x DFLASH 組合式草稿填充（#2 POC v1）
+
+設計依據（社區 + 自家實測）：
+  - llama.cpp #23184：兩策略獨立產生 draft 係 no benefit，須以 pipeline 方式讓
+    ngram 見到前一策略嘅 draft 再延伸。本模組採「填充」變體：DFLASH 仍跑一次 forward
+    （維持 verify 結構不變），但把 draft 塊填成 NGRAM 高精度候選。
+  - 自家 Phase 0 實測：dtn=12 命中時鏈長 12/12、查表延遲 0.02 ms；
+    而 DFLASH draft forward 為 6.6 ms / 8 tokens。
+  - engine 語義（實查）：batch_get 回 (ids, mask)；ids[0] = 已餵入嘅最後一個 token
+    （echo，唔係候選）；ids[1:1+n_cand] = 建議候選；未命中時 ids[1:] 全為 0。
+
+安全：由環境變數 DSH_NGRAM_FILL 控制，未設 = 完全唔生效（零副作用）。
+"""
+import logging
+import os
+import numpy as np
+
+logger = logging.getLogger(__name__)
+
+
+class NgramFillHelper:
+    """喺 DFLASH draft 塊產生之後，用 NGRAM 查表候選替換之。"""
+
+    def __init__(self, block_size, max_trie_depth=18, draft_token_num=8,
+                 min_bfs_breadth=1, max_bfs_breadth=8):
+        from sglang.srt.speculative.cpp_ngram.ngram_corpus import NgramCorpus
+        self.block_size = int(block_size)
+        self.n_cand = int(block_size) - 1
+        self.max_trie_depth = int(max_trie_depth)
+        self.draft_token_num = int(draft_token_num)
+        self.corpus = NgramCorpus(
+            capacity=1000000,
+            max_trie_depth=self.max_trie_depth,
+            match_type="BFS",
+            draft_token_num=self.draft_token_num,
+            min_bfs_breadth=min_bfs_breadth,
+            max_bfs_breadth=max_bfs_breadth,
+        )
+        self._ctx_len = {}
+        self.stats = {"steps": 0, "replaced": 0, "cand_total": 0}
+
+    def _ctx(self, req):
+        n = self.max_trie_depth
+        ins = list(req.origin_input_ids)
+        outs = list(req.output_ids) if req.output_ids is not None else []
+        return (ins[-n:] + outs[-n:])[-n:]
+
+    def fill(self, batch, draft_tokens):
+        """回傳命中並替換嘅候選 token 總數。"""
+        reqs = list(batch.reqs)
+        bs = len(reqs)
+        if bs == 0 or draft_tokens.shape[0] < bs:
+            return 0
+
+        self.stats["steps"] += 1
+        ctxs = [self._ctx(r) for r in reqs]
+        keep = [i for i, c in enumerate(ctxs) if c]
+        if not keep:
+            return 0
+
+        try:
+            self.corpus.batch_put([ctxs[i] for i in keep])
+            self.corpus.synchronize()
+        except Exception as e:
+            logger.warning("ngram_fill: batch_put failed: %s", e)
+            return 0
+
+        tails = [ctxs[i][-self.max_trie_depth:] for i in keep]
+        base_lens = [len(ctxs[i]) for i in keep]
+        rids = [str(reqs[i].rid) for i in keep]
+        try:
+            ids, _mask = self.corpus.batch_get(rids, tails, base_lens)
+        except Exception as e:
+            logger.warning("ngram_fill: batch_get failed: %s", e)
+            return 0
+
+        _a = np.asarray(ids)
+        _d = self.draft_token_num if _a.size % self.draft_token_num == 0 else _a.size // len(keep)
+        _a = _a.reshape(len(keep), _d)
+        if _d < self.draft_token_num:  # 罕見：引擎回短於預期
+            _pad = np.zeros((len(keep), self.draft_token_num - _d), dtype=_a.dtype)
+            _a = np.concatenate([_a, _pad], axis=1)
+        ids = _a
+        filled = 0
+        k_list = []
+        for row, i in enumerate(keep):
+            cand = ids[row][1 : 1 + self.n_cand]
+            cand = cand[cand > 0]
+            if cand.size == 0:
+                continue
+            k = int(cand.size)
+            draft_tokens[i, 1 : 1 + k] = draft_tokens.new_tensor(cand.tolist())
+            filled += k
+            if os.environ.get("DSH_NGRAM_FILL_DEBUG", "0") == "1":
+                logger.info("ngram_fill req=%s k=%d cand=%s", rids[row], k, cand.tolist()[:8])
+            k_list.append(k)
+
+        self.stats["replaced"] += len(k_list)
+        self.stats["cand_total"] += filled
+        if self.stats["steps"] % 50 == 0:
+            s = self.stats
+            logger.info(
+                "ngram_fill: steps=%d hit_reqs=%d (%.1f%%) cand=%d avg_k=%.2f",
+                s["steps"], s["replaced"],
+                100.0 * s["replaced"] / max(1, s["steps"]), s["cand_total"],
+                s["cand_total"] / max(1, s["replaced"]),
+            )
+        return filled
+
+
+def make_from_env(block_size):
+    """由環境變數建立（DSH_NGRAM_FILL=1 才啟用）。"""
+    if os.environ.get("DSH_NGRAM_FILL", "0") != "1":
+        return None
+    dtn = int(os.environ.get("DSH_NGRAM_FILL_DTN", str(block_size)))
+    h = NgramFillHelper(block_size=block_size, draft_token_num=dtn)
+    logger.info("ngram_fill ENABLED: block_size=%d n_cand=%d dtn=%d",
+                block_size, h.n_cand, dtn)
+    return h
