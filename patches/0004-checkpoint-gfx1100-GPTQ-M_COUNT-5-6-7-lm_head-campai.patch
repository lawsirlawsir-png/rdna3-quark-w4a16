index 0000000..4d40e9d
--- /dev/null
+++ b/python/sglang/srt/speculative/hybrid_controller.py
@@ -0,0 +1,804 @@
+# -*- coding: utf-8 -*-
+"""gfx1100 通用 HYBRID speculative decoding：NGRAM（retrieval）× DFLASH（neural）
+
+設計來源：sgl-project/sglang PR #37237 "Batch-level hybrid speculative decoding"（未 merge）
+  - batch 級路由：每 decode batch 揀 retrieval 或 neural，貼近兩者較優者
+  - request 級判定：score = continuation_len * suffix_match_len / draft_width
+  - batch 級判定：合格 request 數 >= bs * min_matching_ratio
+  - 兩個 worker 嘅 CUDA graph 都捕捉好，切換時切換
+
+本檔為 gfx1100（RDNA3）通用實作，差異：
+  1. neural role 用 DFLASH（上游官方只支援 EAGLE3）
+  2. 以加法式 adapter 接入，唔改上游核心檔
+  3. 由環境變數 DSH_HYBRID 控制（預設關 = 零副作用）
+
+註冊方式：
+    SpeculativeAlgorithm.register("HYBRID", spec_class=HybridSpecAlgo)
+"""
+from __future__ import annotations
+
+import json
+import logging
+import os
+from dataclasses import dataclass, field
+from typing import Any, Optional
+
+import torch
+
+logger = logging.getLogger(__name__)
+
+DEFAULT_CONFIG = {
+    "retrieval": {
+        "algorithm": "NGRAM",
+        "speculative_num_draft_tokens": 12,
+        "speculative_ngram_min_bfs_breadth": 1,
+        "speculative_ngram_max_bfs_breadth": 8,
+        "speculative_ngram_match_type": "BFS",
+    },
+    "neural": {
+        "algorithm": "DFLASH",
+        "speculative_num_draft_tokens": 8,
+    },
+    "min_continuation_ratio": 1.0,
+    "min_matching_ratio": 0.5,
+}
+
+
+ROUTE_WIDTHS = {}
+
+
+NEURAL_WIDTH = {}   # EAGLE/DFLASH worker 初始化時要讀
+
+
+
+
+def load_config() -> dict:
+    """由 DSH_HYBRID_CONFIG（JSON 字串）或 DSH_HYBRID_CONFIG_PATH 讀取。"""
+    raw = os.environ.get("DSH_HYBRID_CONFIG")
+    if raw:
+        cfg = json.loads(raw)
+    else:
+        path = os.environ.get("DSH_HYBRID_CONFIG_PATH")
+        if path and os.path.exists(path):
+            cfg = json.loads(open(path, encoding="utf-8").read())
+        else:
+            cfg = dict(DEFAULT_CONFIG)
+    for role in ("retrieval", "neural"):
+        if not isinstance(cfg.get(role), dict):
+            raise ValueError("HYBRID config requires a %s object." % role)
+    for name in ("min_continuation_ratio", "min_matching_ratio"):
+        v = cfg.get(name)
+        if not isinstance(v, (int, float)) or not 0 < float(v) <= 1:
+            raise ValueError("HYBRID %s must be in (0, 1], got %r" % (name, v))
+    return cfg
+
+
+@dataclass
+class RouteStats:
+    retrieval_steps: int = 0
+    neural_steps: int = 0
+    retrieval_tokens: float = 0.0
+    neural_tokens: float = 0.0
+    cont_total: float = 0.0
+    match_total: float = 0.0
+    qualifying_total: int = 0
+    decode_batches: int = 0
+
+    def summary(self) -> dict:
+        return {
+            "decode_batches": self.decode_batches,
+            "retrieval_steps": self.retrieval_steps,
+            "neural_steps": self.neural_steps,
+            "retrieval_share": round(
+                self.retrieval_steps / max(1, self.decode_batches), 3),
+            "avg_cont_len": round(self.cont_total / max(1, self.decode_batches), 2),
+            "avg_match_len": round(self.match_total / max(1, self.decode_batches), 2),
+            "avg_qualifying": round(
+                self.qualifying_total / max(1, self.decode_batches), 2),
+        }
+
+
+class HybridController:
+    """管理 NGRAM 同 DFLASH 兩個 worker，逐 decode batch 路由。"""
+
+    def __init__(self, server_args, gpu_id, ps, nccl_port, target_worker):
+        from sglang.srt.speculative.spec_info import SpeculativeAlgorithm
+
+        self.server_args = server_args
+        self._target_worker = target_worker
+        self.cfg = load_config()
+        self.routing = {
+            "min_continuation_ratio": float(self.cfg["min_continuation_ratio"]),
+            "min_matching_ratio": float(self.cfg["min_matching_ratio"]),
+        }
+        self.stats = RouteStats()
+        self.log_interval = int(os.environ.get("DSH_HYBRID_LOG_INTERVAL", "50"))
+        self._last_route = "neural"
+        self._routes = {}
+        # 【接縫層】每個 route 嘅 native spec_info 分開存放，避免兩個 route
+        # 共用同一個 batch.spec_info 而互相污染（DFLASH 嘅 DFlashDraftInputV2
+        # 同 NGRAM 嘅 NgramVerifyInput 係唔兼容嘅型別，生命週期亦唔同）。
+        self._spec_inputs = {"neural": None, "retrieval": None}
+        self._verify_input = None
+
+        for role in ("retrieval", "neural"):
+            worker = self._build_worker(role, gpu_id, ps, nccl_port)
+            self._routes[role] = worker
+            logger.info("HYBRID: built %s worker = %s", role, type(worker).__name__)
+
+        self.retrieval_worker = self._routes["retrieval"]
+        self.neural_worker = self._routes["neural"]
+        rw = int(self.retrieval_worker.speculative_num_draft_tokens)
+        nw = int(self.neural_worker.speculative_num_draft_tokens)
+        self._width = {"retrieval": rw, "neural": nw}
+
+        # 供 hybrid_patches.patch_hybrid_prepare_for_decode 讀取：DFLASH 嘅
+        # prepare_for_decode 用全局 spec bag 嘅 num_draft_tokens 做 block_size，
+        # HYBRID 之下要顯式覆寫成 neural 自己嘅寬度。
+        global ROUTE_WIDTHS
+        ROUTE_WIDTHS = dict(self._width)
+        NEURAL_WIDTH.clear()
+        NEURAL_WIDTH.update(self._width)
+        self.min_continuation = (rw - 1) * self.routing["min_continuation_ratio"]
+        logger.info(
+            "HYBRID ready: retrieval=%s(width=%d) neural=%s(width=%d) "
+            "min_cont=%.2f min_matching=%.2f",
+            type(self.retrieval_worker).__name__, rw,
+            type(self.neural_worker).__name__, nw,
+            self.min_continuation, self.routing["min_matching_ratio"],
+        )
+
+    # ---------- 建構 ----------
+    def _build_worker(self, role, gpu_id, ps, nccl_port):
+        """為每個 role 造獨立 ServerArgs 副本，再直接建 worker。"""
+        role_cfg = dict(self.cfg[role])
+        algo = role_cfg.pop("algorithm")
+        changes = {"speculative_algorithm": algo}
+        changes.update(role_cfg)
+        try:
+            sargs = self.server_args.replace_resolved("hybrid.%s" % role, **changes)
+        except Exception as e:
+            logger.warning("HYBRID: replace_resolved failed (%s), fallback to copy", e)
+            import copy
+            sargs = copy.deepcopy(self.server_args)
+            for k, v in changes.items():
+                setattr(sargs, k, v)
+
+        # sysargs 必須 deepcopy：replace_resolved 可能共享底層，直接 setattr 會污染主 config
+        try:
+            import copy as _copy
+            sargs = _copy.deepcopy(sargs)
+        except Exception as e:
+            logger.warning("HYBRID: deepcopy sargs failed: %s", e)
+
+        # neural role 用獨立 draft model，唔可以繼承主模型嘅 model_path/quantization。
+        # server_args 係 read-only ⇒ 必須用 scoped config-bag override（context manager）。
+        # 否則 DFLASH draft ModelRunner 會用主模型路徑建 ModelConfig，去搵 gptq config 而：
+        #   ValueError: Cannot find the config file for gptq
+        model_over = {}
+        spec_force = {}
+        _direct = []
+        if algo == "DFLASH":
+            draft_path = getattr(sargs, "speculative_draft_model_path", None) or \
+                role_cfg.get("speculative_draft_model_path")
+            if draft_path:
+                model_over["model_path"] = draft_path
+                # fork 喺啟動時將 unquant 轉 None 並設 explicitly_set=False
+                # （serving_hook.py:634-651）。runtime override 會繞過該轉換，
+                # 故必須兩者一齊設（同屬 spec bag），否則 ModelConfig 會當
+                # 「已明確指定」而拒絕由 checkpoint 推導，最終沿用主模型 gptq。
+                # 註：draft 嘅 quantization 來自 get_spec()，唔係 get_model()。
+                spec_force["speculative_draft_model_quantization"] = None
+                spec_force["_speculative_draft_quantization_explicitly_set"] = False
+                spec_force["speculative_draft_model_path"] = draft_path
+                _direct = [("model_path", draft_path),
+                           ("quantization", None),
+                           ("speculative_draft_model_quantization", None),
+                           ("_speculative_draft_quantization_explicitly_set", False)]
+
+        # 上游 controller 會為每個 role 呼叫 handle_server_args；唔做嘅話
+        # NGRAM 專屬欄位（如 speculative_ngram_external_sam_budget）仍係 None，
+        # 會令 NgramCorpus.__ffi_init__ 收 None 而 TypeError。
+        try:
+            from sglang.srt.speculative.spec_info import SpeculativeAlgorithm
+            _algo = SpeculativeAlgorithm.from_string(algo)
+            if _algo is not None and hasattr(_algo, "handle_server_args"):
+                _algo.handle_server_args(sargs)
+                logger.info("HYBRID: handle_server_args(%s) applied for %s", algo, role)
+        except Exception as e:
+            logger.warning("HYBRID: handle_server_args(%s) failed: %s", algo, e)
+
+        # 決定性一步（必須喺 handle_server_args 之後！）：serving_hook 有
+        #   if speculative_draft_model_quantization is None: → 繼承主模型 quantization
+        # 所以若先設 None，會被 handle 改回 gptq。TpModelWorker._init_model_config
+        # 又係讀自 sargs 本身（resolving_view 唔會由 bag 重投影）⇒ 必須最後直接改。
+        if _direct:
+            for _k, _v in _direct:
+                try:
+                    object.__setattr__(sargs, _k, _v)
+                except Exception as _e:
+                    logger.warning("HYBRID: direct set %s failed: %s", _k, _e)
+            logger.info("HYBRID: neural direct sargs (post-handle) model_path=%s "
+                        "quantization=None draft_quant=None explicitly_set=False",
+                        sargs.model_path)
+
+        if algo in ("EAGLE", "EAGLE3"):
+            # MTP / EAGLE：draft 模型通常就係 target 自己（內建 MTP head），
+            # 唔需要 model_over / quantization 覆寫（沿用 target 嘅 gptq）。
+            from sglang.srt.speculative.eagle_worker_v2 import EAGLEWorkerV2 as _EW
+            worker_cls = _EW
+        elif algo == "NGRAM":
+            from sglang.srt.speculative.ngram_worker import NGRAMWorker as _NW
+            worker_cls = _NW
+        elif algo == "DFLASH":
+            from sglang.srt.speculative.dflash_worker_v2 import DFlashWorkerV2 as _DW
+            worker_cls = _DW
+        else:
+            raise ValueError("HYBRID %s algorithm unsupported: %s (gfx1100 POC "
+                             "supports NGRAM/DFLASH)" % (role, algo))
+
+        # 關鍵：worker 內部用 get_spec()（runtime context 全局）讀參數，
+        # 單靠 replace_resolved 改 server_args 係改唔到嘅 ⇒ 必須隔離 context。
+        # 上游做法：hybrid_controller.py:328 get_context().override(...)
+        try:
+            from sglang.srt.runtime_context import get_context
+            base_d = self.server_args.resolved_dict()
+            role_d = sargs.resolved_dict()
+            # 只 override 該 role 真正需要嘅參數（白名單）。
+            # 若全量 override，會將主模型嘅 quantization=gptq 等帶入 draft
+            # model context，令 draft 去找唔存在嘅 gptq config 而失敗。
+            if algo == "NGRAM":
+                allow = {"speculative_algorithm", "speculative_num_draft_tokens",
+                         "speculative_ngram_min_bfs_breadth",
+                         "speculative_ngram_max_bfs_breadth",
+                         "speculative_ngram_match_type",
+                         "speculative_ngram_max_trie_depth",
+                         "speculative_ngram_capacity",
+                         "speculative_ngram_external_sam_budget",
+                         "speculative_ngram_external_corpus_path",
+                         "speculative_ngram_external_corpus_max_tokens"}
+            else:
+                allow = {"speculative_algorithm", "speculative_num_draft_tokens",
+                         "speculative_draft_model_path", "speculative_num_steps",
+                         "speculative_eagle_topk"}
+            diff = {k: v for k, v in role_d.items()
+                    if k in allow and base_d.get(k) != v}
+            spec_over = dict(diff)
+            spec_over.update(spec_force)   # 強制值優先（draft quantization 等）
+            restore = {k: base_d.get(k) for k in spec_over}
+            import contextlib
+            with contextlib.ExitStack() as stack:
+                if spec_over:
+                    spec_bag = get_context().config_bag("spec")
+                    stack.enter_context(spec_bag.override(**spec_over))
+                    logger.info("HYBRID: spec-bag override for %s (%d keys): %s",
+                                role, len(spec_over), sorted(spec_over))
+                if model_over:
+                    model_bag = get_context().config_bag("model")
+                    stack.enter_context(model_bag.override(**model_over))
+                    logger.info("HYBRID: model-bag override for %s (%d keys)",
+                                role, len(model_over))
+                w = worker_cls(server_args=sargs, gpu_id=gpu_id, ps=ps,
+                               nccl_port=nccl_port, target_worker=self._target_worker)
+        except Exception as e:
+            logger.warning("HYBRID: scoped override failed (%s); direct build", e)
+            w = worker_cls(server_args=sargs, gpu_id=gpu_id, ps=ps,
+                           nccl_port=nccl_port, target_worker=self._target_worker)
+        return w
+
+    # ---------- 委派介面（BaseSpecWorker 契約） ----------
+    @property
+    def target_worker(self):
+        return self._target_worker
+
+    @property
+    def draft_worker(self):
+        return self.neural_worker.draft_worker
+
+    @property
+    def last_shared_read_runner(self):
+        return self.neural_worker.last_shared_read_runner
+
+    @property
+    def spec_v2_attn_backends(self):
+        out = []
+        for w in self._routes.values():
+            try:
+                out.extend(w.spec_v2_attn_backends or ())
+            except Exception:
+                pass
+        return tuple(dict.fromkeys(out))
+
+    def alloc_memory_pool(self, **kwargs):
+        for role, w in self._routes.items():
+            logger.info("HYBRID: alloc_memory_pool START %s", role)
+            try:
+                w.alloc_memory_pool(**kwargs)
+                logger.info("HYBRID: alloc_memory_pool DONE %s", role)
+            except Exception as e:
+                logger.error("HYBRID: alloc_memory_pool FAILED %s: %s", role, e)
+                raise
+
+    # 【關鍵順序】neural 必須先於 retrieval：
+    # 兩者共用同一個 target model object，而 neural（DFLASH）會透過
+    # model.set_dflash_layers_to_capture([5,19,33,47,61]) 設定目標模型要捕捉
+    # 5 層 aux hidden states。若 retrieval 先捕捉，目標模型仍係「未設捕捉層」
+    # 狀態 ⇒ buffer 尺寸（1 層）與其後 neural 捕捉（5 層）不一致 ⇒
+    # CUDA illegal memory access / Capture cuda graph failed。
+    _ORDER = ("neural", "retrieval")
+
+    def _ordered_routes(self):
+        out = []
+        for role in self._ORDER:
+            w = self._routes.get(role)
+            if w is not None:
+                out.append((role, w))
+        return out or list(self._routes.items())
+
+    def init_attention_backends(self):
+        for role, w in self._ordered_routes():
+            logger.info("HYBRID: init_attn_backends START %s", role)
+            try:
+                w.init_attention_backends()
+                logger.info("HYBRID: init_attn_backends DONE %s", role)
+            except Exception as e:
+                logger.error("HYBRID: init_attn_backends FAILED %s: %s", role, e)
+                raise
+
+    def init_cuda_graphs(self):
+        # target verify CUDA graph 由 target worker 嘅 model_runner 捕捉，而佢讀
+        # 全局 spec bag 嘅 speculative_num_draft_tokens。HYBRID 之下該值係最寬
+        # route（NGRAM=12），但每個 route 嘅 verify 寬度唔同（DFLASH=8）⇒ 捕捉時
+        # forward_batch.spec_info 為 None 而寬度不符 ⇒ GDN backend 爆
+        # （gdn_backend.py:753 spec_info.draft_token_num）。
+        # ⇒ 逐 route 用 scoped override 將 spec bag 設回該 route 自己嘅寬度。
+        import contextlib
+        from sglang.srt.runtime_context import get_context
+        for role, w in self._ordered_routes():
+            width = self._width.get(role)
+            logger.info("HYBRID: init_cuda_graphs START %s (%s, width=%s)",
+                        role, type(w).__name__, width)
+            try:
+                with contextlib.ExitStack() as stack:
+                    if width is not None:
+                        spec_bag = get_context().config_bag("spec")
+                        stack.enter_context(
+                            spec_bag.override(speculative_num_draft_tokens=int(width)))
+                    w.init_cuda_graphs()
+                logger.info("HYBRID: init_cuda_graphs DONE %s", role)
+            except Exception as e:
+                logger.error("HYBRID: init_cuda_graphs FAILED %s: %s", role, e)
+                raise
+
+    def clear_cache_pool(self):
+        for w in self._routes.values():
+            try:
+                w.clear_cache_pool()
+            except Exception as e:
+                logger.warning("HYBRID clear_cache_pool: %s", e)
+
+    def on_verify_complete_cpu(self, num_correct_drafts_per_req, batch_size=0):
+        w = self._routes.get(self._last_route)
+        if w is not None:
+            try:
+                w.on_verify_complete_cpu(num_correct_drafts_per_req, batch_size)
+            except TypeError:
+                w.on_verify_complete_cpu(num_correct_drafts_per_req)
+
+    def activate_step_by_batch(self, batch_size):
+        for w in self._routes.values():
+            fn = getattr(w, "activate_step_by_batch", None)
+            if fn is not None:
+                fn(batch_size)
+
+    def note_request_finished(self, **kwargs):
+        for w in self._routes.values():
+            fn = getattr(w, "note_request_finished", None)
+            if fn is not None:
+                try:
+                    fn(**kwargs)
+                except Exception:
+                    pass
+
+    # ---------- 路由 ----------
+    def _decide_route(self, batch):
+        """回傳 (route, qualifying, total)。任何異常一律 fallback neural。"""
+        neural = "neural"
+        try:
+            from sglang.srt.model_executor.forward_batch_info import ForwardMode
+            fm = batch.forward_mode
+            if not fm.is_decode() or fm.is_target_verify():
+                return neural, 0, len(batch.reqs)
+            info = self.retrieval_worker.get_retrieval_info(batch)
+            if info is None:
+                return neural, 0, len(batch.reqs)
+            conts, matches = info
+            width = self._width["retrieval"]
+            qualifying = 0
+            _scores = []
+            for c, m in zip(conts, matches):
+                score = float(c) * float(m) / max(1, width)
+                _scores.append(score)
+                if score >= self.min_continuation:
+                    qualifying += 1
+            # _DSH_ROUTE_PROBE: 逐 request 決策依據（唔止平均）
+            try:
+                import os as _os3
+                if _os3.environ.get("DSH_HYBRID_ROUTE_PROBE", "0") == "1":
+                    logger.error(
+                        "HYBRID-ROUTE: bs=%d width=%d min_cont=%.3f "
+                        "conts=%s matches=%s scores=%s qualifying=%d",
+                        len(batch.reqs), width, self.min_continuation,
+                        [int(x) for x in conts[:6]], [int(x) for x in matches[:6]],
+                        ["%.3f" % s for s in _scores[:6]], qualifying)
+            except Exception:
+                pass
+            bs = len(batch.reqs)
+            self.stats.cont_total += sum(float(x) for x in conts)
+            self.stats.match_total += sum(float(x) for x in matches)
+            self.stats.qualifying_total += qualifying
+            if bs > 0 and qualifying >= bs * self.routing["min_matching_ratio"]:
+                return "retrieval", qualifying, bs
+            return neural, qualifying, bs
+        except Exception as e:
+            logger.warning("HYBRID routing failed, fallback neural: %s", e)
+            return neural, 0, len(batch.reqs)
+
+    def _bind_route_spec_input(self, route, spec_info):
+        """【轉換層】以 HybridVerifyInput 作容器，但只將「該 route 嘅 native
+        state」派落 batch，唔會將另一方嘅欄位灌入去。
+
+        為何需要容器：BatchTokenToKVPool 等共享路徑會對 batch.spec_info 做
+        filter_batch / merge_batch / future_indices 等生命週期操作；容器令
+        兩個 route 嘅 state 都可以接到呢啲操作，而實際 forward 永遠只見自己
+        嘅 native 型別（DFLASH 有 isinstance 檢查，收到 wrapper 會爆）。
+        """
+        self._spec_inputs[route] = spec_info
+        neural = self._spec_inputs.get("neural")
+        retrieval = self._spec_inputs.get("retrieval")
+        if neural is None and retrieval is None:
+            return None
+        if self._verify_input is None:
+            from sglang.srt.speculative.hybrid_info import HybridVerifyInput
+            self._verify_input = HybridVerifyInput(neural, retrieval)
+        else:
+            self._verify_input.neural_input = neural
+            self._verify_input.retrieval_input = retrieval
+        return self._verify_input.pick(route)
+
+    def forward_batch_generation(self, batch, on_publish=None,
+                                 grammar_barrier=None, pp_proxy_tensors=None,
+                                 **kwargs):
+        """透明委派：所有排程器傳入嘅參數都要原樣轉發俾底層 worker，
+        否則（如 grammar_barrier）會被吞掉而令 verify 階段狀態不一致。
+
+        【接縫協議】兩個 route 共用同一個 target model object，但各自嘅 spec
+        state 型別唔同（DFLASH=DFlashDraftInputV2/block_width=8/5 層 aux；
+        NGRAM=NgramVerifyInput/tree width=12）。呢度按 route 顯式轉換：
+        batch.spec_info 只會見到該 route 自己嘅 native 型別。
+        """
+        route, qual, bs = self._decide_route(batch)
+        import os as _os2
+        if _os2.environ.get("DSH_HYBRID_FORCE_NEURAL", "0") == "1":
+            route, qual, bs = ("neural", 0, len(batch.reqs))
+        elif _os2.environ.get("DSH_HYBRID_FORCE_RETRIEVAL", "0") == "1":
+            route, qual, bs = ("retrieval", 0, len(batch.reqs))
+        # HYBRID-ACCEPT-ROUTER: route by MEASURED accept length, not by the
+        # corpus match score. _decide_route() only asks 'does the corpus have
+        # ANY material' (cont*match/width >= 0.05) - it never asks whether that
+        # route actually PAYS OFF. Measured at 19K context: retrieval was chosen
+        # for 68% of steps while its accept was only 1.2, whereas neural (DFLASH)
+        # accepted ~3.0 - so the router was sending most steps to the losing
+        # route (22 t/s instead of ~34). Track each route's recent accept with
+        # an EMA and prefer the route that is measurably winning.
+        try:
+            import os as _os_ar
+            if _os_ar.environ.get('DSH_HYBRID_ACCEPT_ROUTER', '1') == '1':
+                if not hasattr(self, '_acc_ema'):
+                    self._acc_ema = {'retrieval': None, 'neural': None}
+                _e = self._acc_ema
+                _marg = float(_os_ar.environ.get('DSH_HYBRID_ACCEPT_MARGIN', '0.15'))
+                if _e.get('retrieval') is not None and _e.get('neural') is not None:
+                    _best = 'retrieval' if _e['retrieval'] >= _e['neural'] + _marg else (
+                            'neural' if _e['neural'] >= _e['retrieval'] + _marg else route)
+                    if _best != route:
+                        logger.error('HYBRID-ACCEPT-ROUTER: %s -> %s (ema ret=%.3f neu=%.3f)',
+                                     route, _best, _e['retrieval'], _e['neural'])
+                    route = _best
+        except Exception:
+            pass
+        # HYBRID-HYSTERESIS: the decisive fix. Forensics (2026-09-12):
+        # _decide_route() is recomputed EVERY step and NGRAM's qualifying
+        # signal oscillates (avg_qualifying ~0.55), so the route flipped on
+        # CONSECUTIVE steps: retrieval->neural->retrieval->neural in the same
+        # second, retrieval_share 0.55. Every handoff fix (rebase / drop /
+        # sticky) was treating the symptom - the real defect is that the
+        # switch should not be happening every step at all. Require the
+        # decider to prefer the other route for DSH_HYBRID_SWITCH_PATIENCE
+        # consecutive steps before the route actually changes.
+        try:
+            import os as _os_hy
+            _pat = int(_os_hy.environ.get('DSH_HYBRID_SWITCH_PATIENCE', '8'))
+            if _pat > 0:
+                if not hasattr(self, '_hold_route') or self._hold_route is None:
+                    self._hold_route = route
+                    self._hold_pend = None
+                if route == self._hold_route:
+                    self._hold_pend = None
+                else:
+                    if self._hold_pend is not None and self._hold_pend[0] == route:
+                        self._hold_pend = (route, self._hold_pend[1] + 1)
+                    else:
+                        self._hold_pend = (route, 1)
+                    if self._hold_pend[1] >= _pat:
+                        logger.error('HYBRID-HYSTERESIS: switch %s -> %s after %d consecutive',
+                                     self._hold_route, route, self._hold_pend[1])
+                        self._hold_route = route
+                        self._hold_pend = None
+                route = self._hold_route
+        except Exception:
+            pass
+        # HYBRID-STICKY: decide the route ONCE per request and keep it for the
+        # whole request. Forensics (2026-09-12): with switching enabled the
+        # SAME 12.4K DSH-shaped prompt produces corrupted text
+        # (448GBGB / Qwen3.8-3.8-INT-INT4-G-GPTQ-v3 / repeated fragments),
+        # while FORCE_NEURAL on the identical prompt is perfectly clean.
+        # Both routes are clean in isolation; only the mid-request handoff
+        # corrupts. Latching removes the handoff entirely.
+        try:
+            import os as _os_st
+            if _os_st.environ.get('DSH_HYBRID_STICKY_ROUTE', '0') == '1':
+                if not hasattr(self, '_sticky'):
+                    self._sticky = {}
+                _rids = tuple(getattr(r, 'rid', str(i)) for i, r in enumerate(batch.reqs))
+                if len(_rids) == 1:
+                    _pin = self._sticky.get(_rids[0])
+                    if _pin is None:
+                        if len(self._sticky) > 512:
+                            self._sticky.clear()
+                        self._sticky[_rids[0]] = route
+                    else:
+                        if _pin != route:
+                            logger.error('HYBRID-STICKY: keep %s (decider said %s)', _pin, route)
+                        route = _pin
+        except Exception:
+            pass
+
+        entry_spec = getattr(batch, "spec_info", None)
+        try:
+            from sglang.srt.speculative.hybrid_info import HybridVerifyInput
+            _is_wrapper = isinstance(entry_spec, HybridVerifyInput)
+        except Exception:
+            _is_wrapper = False
+
+        if _is_wrapper:
+            self._spec_inputs["neural"] = entry_spec.neural_input
+            self._spec_inputs["retrieval"] = entry_spec.retrieval_input
+            self._verify_input = entry_spec
+        elif entry_spec is not None:
+            # 上一 iteration 由某個 worker 交落嘅 native draft input。
+            # 若型別唔屬當前 route，代表係另一 route 嘅殘留 ⇒ 唔可以派落去。
+            _owner = None
+            for _r, _v in self._spec_inputs.items():
+                if _v is entry_spec:
+                    _owner = _r
+            self._spec_inputs[route if _owner is None else _owner] = entry_spec
+        elif getattr(self, "_spec_inputs", None) is None:
+            self._spec_inputs = {"neural": None, "retrieval": None}
+
+        # HYBRID-HANDOFF: on a route switch the incoming route's stored native
+        # draft state belongs to an OLD position - the other route advanced the
+        # sequence by accept_len tokens since it was built. Binding it makes the
+        # verify place its block at stale slots, so the token already emitted
+        # there is re-verified and re-emitted. Forensics: exactly one duplicated
+        # token per switch, and the TARGET MODEL CONFIRMS the duplicate, which
+        # proves its context is missing the previous token (stale KV/GDN state).
+        # Fix: drop the stale state so the incoming route rebuilds from the
+        # CURRENT sequence on this step (it takes the existing first-time/idle
+        # path, then resumes normal drafting). Cost is one non-speculative step
+        # per switch; benefit is a correct handoff.
+        try:
+            import os as _os_hd
+            _sw = (self._last_route is not None and route != self._last_route)
+            if _sw and _os_hd.environ.get('DSH_HYBRID_HANDOFF_FIX', '1') == '1':
+                _stale = self._spec_inputs.get(route)
+                if _stale is not None:
+                    try:
+                        _nsl = getattr(_stale, 'new_seq_lens', None)
+                        _nv = _nsl.tolist() if _nsl is not None else None
+                    except Exception:
+                        _nv = '?'
+                    try:
+                        _bsl = batch.seq_lens.tolist() if hasattr(batch, 'seq_lens') else None
+                    except Exception:
+                        _bsl = None
+                    logger.error(
+                        'HYBRID-HANDOFF: %s -> %s drop stale %s (native_new_seq_lens=%s batch_seq_lens=%s)',
+                        self._last_route, route, type(_stale).__name__, _nv, _bsl)
+                    self._spec_inputs[route] = None
+        except Exception:
+            pass
+        native = self._bind_route_spec_input(route, self._spec_inputs.get(route))
+        if native is None:
+            # 該 route 第一次行：清空另一 route 嘅殘留，令 worker 走 idle path
+            # 而唔係收到唔兼容嘅型別。
+            batch.spec_info = None
+        else:
+            batch.spec_info = native
+
+        try:
+            _si = batch.spec_info
+            _fm = getattr(getattr(batch, "forward_mode", None), "name", "?")
+            logger.info(
+                "HYBRID diag: route=%s fm=%s entry=%s native=%s wrapped=%s bs=%d",
+                route, _fm,
+                type(entry_spec).__name__ if entry_spec is not None else None,
+                type(_si).__name__ if _si is not None else None, _is_wrapper, bs)
+        except Exception:
+            pass
+
+        self._last_route = route
+        self.stats.decode_batches += 1
+        if route == "retrieval":
+            self.stats.retrieval_steps += 1
+        else:
+            self.stats.neural_steps += 1
+        if self.log_interval and self.stats.decode_batches % self.log_interval == 0:
+            logger.info("HYBRID stats: %s (last route=%s q=%d/%d)",
+                        self.stats.summary(), route, qual, bs)
+        w = self._routes[route]
+        call_kw = dict(kwargs)
+        if on_publish is not None:
+            call_kw["on_publish"] = on_publish
+        if grammar_barrier is not None:
+            call_kw["grammar_barrier"] = grammar_barrier
+        if pp_proxy_tensors is not None:
+            call_kw["pp_proxy_tensors"] = pp_proxy_tensors
+        try:
+            try:
+                result = w.forward_batch_generation(batch, **call_kw)
+            except TypeError as e:
+                # 底層 worker 可能唔收某啲參數（如 NGRAM 無 grammar_barrier）
+                logger.debug("HYBRID: retry without extras (%s)", e)
+                result = w.forward_batch_generation(batch, on_publish=on_publish)
+            # 記錄該 route 今次交出嘅 native draft input（下一 iteration 用）
+            self._spec_inputs[route] = getattr(batch, "spec_info", None)
+            if getattr(result, "next_draft_input", None) is not None:
+                self._spec_inputs[route] = result.next_draft_input
+            # HYBRID-ACCEPT-ROUTER: record this step's realised accept length.
+            try:
+                import os as _os_ar2
+                if _os_ar2.environ.get('DSH_HYBRID_ACCEPT_ROUTER', '1') == '1':
+                    _al_v = getattr(result, 'accept_lens', None)
+                    if _al_v is not None:
+                        _a = float(_al_v.float().mean().item())
+                        _ema = getattr(self, '_acc_ema', None)
+                        if _ema is None:
+                            _ema = self._acc_ema = {'retrieval': None, 'neural': None}
+                        _p = _ema.get(route)
+                        _ema[route] = _a if _p is None else (0.9 * _p + 0.1 * _a)
+            except Exception:
+                pass
+            return result
+        finally:
+            # 【不污染】wrapper 或另一 route 嘅殘留唔可以漏落下一 batch
+            if hasattr(batch, "spec_info"):
+                _out = batch.spec_info
+                try:
+                    from sglang.srt.speculative.hybrid_info import (
+                        HybridVerifyInput as _HVI,
+                    )
+                    if isinstance(_out, _HVI):
+                        batch.spec_info = self._spec_inputs.get(route)
+                except Exception:
+                    pass
+
+
+# DFLASH block_size=8；EAGLE/MTP 由 config 決定（MTP 3-step/topk1 => 4）
+NEURAL_WIDTH_FALLBACK = 8
+
+
+def _neural_width():
+    try:
+        n = load_config()["neural"]
+        if str(n.get("algorithm", "")).upper() in ("EAGLE", "EAGLE3"):
+            return int(n.get("speculative_num_steps", 3)) + 1
+        return int(n.get("speculative_num_draft_tokens", NEURAL_WIDTH_FALLBACK))
+    except Exception:
+        return NEURAL_WIDTH_FALLBACK
+
+
+def _neural_algo():
+    """由 DSH_HYBRID_CONFIG 讀 neural route 嘅算法名。"""
+    try:
+        return str(load_config()["neural"]["algorithm"]).upper()
+    except Exception:
+        return "DFLASH"
+
+
+def _make_spec_class():
+    """【關鍵】HYBRID 必須用自訂 spec_class，唔可以用默認 CustomSpecAlgo。
+
+    默認 CustomSpecAlgo.get_num_tokens_per_req_for_target_verify 直接回
+    num_draft_tokens（= 最寬 route，例如 NGRAM 12），而 target verify 只由
+    neural route（DFLASH）行，其寬度係 block_size = 8。寬度不符會令 target
+    verify CUDA graph 以錯寬捕捉 ⇒ GDN/Mamba backend 讀
+    spec_info.draft_token_num 爆 AttributeError。
+    （fork 文件明示：pass spec_class=Type[CustomSpecAlgo] 可覆寫任何 is_*/方法）
+    """
+    from sglang.srt.speculative.spec_registry import CustomSpecAlgo
+
+    class _HybridSpecAlgo(CustomSpecAlgo):
+        # 上游 PR #37237 為 HYBRID 加嘅整合方法（scheduler/model_runner 會查）。
+        # neural route 係 EAGLE-family 風格（需 draft hidden states）。
+        def carries_draft_hidden_states(self) -> bool:
+            return True
+
+        def need_topk(self) -> bool:
+            return True
+
+        def is_dflash(self) -> bool:
+            # 只有 neural route 真係 DFLASH 時才宣告，否則 EAGLE/MTP 會被
+            # 錯誤導入 DFLASH 專屬路徑（prepare_for_decode 等）。
+            return _neural_algo() in ("DFLASH", "DSPARK")
+
+        def is_dflash_family(self) -> bool:
+            # 【必要】spec_aux_hidden_state._resolve_dflash_aux_hidden_state 嘅條件係
+            #   if spec_algorithm.is_dflash_family() and not is_draft_worker:
+            # 唔回 True 就完全跳過設定 ⇒ config.dflash_use_aux_hidden_state 永遠 False
+            # ⇒ 冇呼叫 model.set_dflash_layers_to_capture(target_layer_ids)
+            # ⇒ 目標只捕捉 1 層，而 DFLASH 需要 num_context_features=5 層 ⇒
+            #   ValueError: target_hidden feature dim mismatch [N,25600] vs [_,5120]
+            return True
+
+        def create_future_map(
+            self,
+            device,
+            req_to_token_pool,
+            needs_cpu_seq_lens: bool = True,
+            needs_confidence_relay: bool = False,
+        ):
+            from sglang.srt.managers.overlap_utils import FutureMap
+
+            return FutureMap(
+                device,
+                self,
+                req_to_token_pool,
+                needs_cpu_seq_lens,
+                needs_confidence_relay,
+            )
+
+        def get_num_tokens_per_req_for_target_verify(
+            self, num_draft_tokens, is_draft_worker
+        ):
+            logger.error(
+                "HYBRID-GRAPH: HYBRID spec_class width hook CALLED "
+                "num_draft_tokens=%s is_draft_worker=%s -> %s",
+                num_draft_tokens, is_draft_worker, NEURAL_WIDTH_FALLBACK,
+            )
+            return int(NEURAL_WIDTH_FALLBACK)
+
+    return _HybridSpecAlgo
+
+
+def register() -> bool:
+    """以 fork 嘅擴展點註冊 HYBRID（唔改上游核心）。"""
+    try:
+        from sglang.srt.speculative.spec_info import SpeculativeAlgorithm
+    except Exception as e:
+        logger.warning("HYBRID register: cannot import SpeculativeAlgorithm: %s", e)
+        return False
+    try:
+        spec_cls = _make_spec_class()
+
+        @SpeculativeAlgorithm.register(
+            "HYBRID", supports_overlap=False, spec_class=spec_cls
+        )
+        def _factory(server_args):
+            return HybridController
+
+        logger.error("HYBRID registered with custom spec_class (%s)", spec_cls.__name__)
+        return True
+    except Exception as e:
+        logger.warning("HYBRID register failed: %s", e)
+        return False
