+def patch_hybrid_spec_object():
+    """【轉換層 · 關鍵】直接 patch registry 內已存在嘅 HYBRID spec 物件。
+
+    為何唔靠 spec_class：spec_registry 嘅 HYBRID 一經註冊就會快取，
+    hybrid_register.ensure_registered 見 _REGISTRY["HYBRID"] 已存在即提前返回，
+    令後來帶 spec_class 嘅 register() 永遠唔會執行 ⇒ 用嘅係默認
+    CustomSpecAlgo，其 get_num_tokens_per_req_for_target_verify 直接回
+    num_draft_tokens（= 最寬 route，NGRAM 12）。
+    但 target verify 只由 neural route（DFLASH, block_size=8）行 ⇒ 寬度不符
+    ⇒ target verify CUDA graph 以錯寬捕捉 ⇒ GDN/Mamba backend 讀
+    spec_info.draft_token_num 爆 AttributeError。
+
+    故直接改 registry 內嗰個物件（唔理它點嚟）。
+    """
+    try:
+        from sglang.srt.speculative.spec_registry import _REGISTRY
+    except Exception as e:
+        logger.warning("HYBRID: spec-object patch import failed: %s", e)
+        return False
+    spec = _REGISTRY.get("HYBRID")
+    if spec is None:
+        logger.warning("HYBRID: spec-object patch: HYBRID not in registry")
+        return False
+    if getattr(spec, "_dsh_width_patched", False):
+        return True
+
+    try:
+        from sglang.srt.speculative.hybrid_controller import _neural_width
+        width = int(_neural_width())
+    except Exception:
+        width = int(os.environ.get("DSH_HYBRID_NEURAL_WIDTH", "8"))
+
+    def _width_hook(num_draft_tokens, is_draft_worker):
+        logger.error(
+            "HYBRID-GRAPH: spec-object width hook CALLED "
+            "num_draft_tokens=%s is_draft_worker=%s -> %s",
+            num_draft_tokens, is_draft_worker, width)
+        return width
+
+    # 實例層優先（若允許），否則類別層 fallback
+    try:
+        object.__setattr__(
+            spec, "get_num_tokens_per_req_for_target_verify", _width_hook)
+        patched = "instance"
+    except Exception:
+        try:
+            type(spec).get_num_tokens_per_req_for_target_verify = (
+                lambda self, n, d: _width_hook(n, d))
+            patched = "class"
+        except Exception as e:
+            logger.warning("HYBRID: spec-object patch failed: %s", e)
+            return False
+    try:
+        object.__setattr__(spec, "_dsh_width_patched", True)
+    except Exception:
+        pass
+    logger.error(
+        "HYBRID-GRAPH: spec-object width patched (%s) -> target verify width=%d",
+        patched, width)
+    return True
+
