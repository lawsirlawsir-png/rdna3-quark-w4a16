+
+    HybridController.preloaded_weights_bytes = property(preloaded_weights_bytes)
+    HybridController.graph_memory_usage = property(graph_memory_usage)
+    HybridController.graph_time_usage = property(graph_time_usage)
+    HybridController.weight_load_time = property(weight_load_time)
+    HybridController.prewarm_sampling = prewarm_sampling
+    HybridController._dsh_stats_patched = True
+    logger.info("HYBRID: HybridController stats delegated")
