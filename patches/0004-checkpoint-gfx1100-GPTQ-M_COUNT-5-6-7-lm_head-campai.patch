+def patch_force_aux_capture_layers():
+    """【契約層】按目標模型實際使用嘅契約方法設定 aux 捕捉層。
+
+    同時支援兩種契約（實測差異）：
+      1. EAGLE3：
+           wrapper.set_eagle3_layers_to_capture(layer_ids=None)
+               -> self.capture_aux_hidden_states = True
+               -> self.model.capture_aux_hidden_states = True
+               -> self.model.set_eagle3_layers_to_capture()   <-- 唔傳 ids！
+           inner.set_eagle3_layers_to_capture(layer_ids=None) 會 fallback 到硬編
+               [2, num_layers//2, num_layers-3]，**忽略 draft config 嘅 ids**。
+           => 必須自己設 flag + 直接以權威 ids 呼叫 inner 方法。
+      2. DFLASH：wrapper.set_dflash_layers_to_capture(ids)
+           -> flag = True
+           -> self.model.set_dflash_layers_to_capture([i + 1 for i in ids])
+
+    共同陷阱（兩個合約都有）：模型物件由多個 route 共用時，
+    inner 嘅 _is_layer_to_capture 只會 setattr(True)，從不清除，
+    殘留會令捕捉層數膨脹（實測 61 層 = 312320 特徵）=> KV 越界。
+    """
+    try:
+        from sglang.srt.model_executor.model_runner import ModelRunner
+    except Exception as e:
+        logger.warning("HYBRID: force-aux import failed: %s", e)
+        return False
+    if getattr(ModelRunner, "_dsh_force_aux_patched", False):
+        return True
+
+    _orig = ModelRunner.init_attention_backends
+
+    def init_attention_backends(self):
+        _orig(self)
+        try:
+            if getattr(self, "is_draft_worker", False):
+                return
+            sac = getattr(self, "spec_aux_config", None)
+            # _DSH_PROBE: 每次 init_attention_backends 都記錄，睇邊個條件令 patch 唔行
+            try:
+                logger.error(
+                    "HYBRID-FORCE-PROBE: runner=%s is_draft=%s sac=%s "
+                    "eagle=%s dflash=%s",
+                    type(self).__name__, getattr(self, "is_draft_worker", None),
+                    sac is not None,
+                    getattr(sac, "eagle_use_aux_hidden_state", None) if sac else None,
+                    getattr(sac, "dflash_use_aux_hidden_state", None) if sac else None)
+            except Exception:
+                pass
+            if sac is None:
+                return
+            model = getattr(self, "model", None)
+            if model is None:
+                return
+
+            # 鏈：wrapper -> inner
+            chain = []
+            _cur = model
+            while _cur is not None and len(chain) < 4:
+                chain.append(_cur)
+                _cur = getattr(_cur, "model", None)
+            names = [type(o).__name__ for o in chain]
+
+            def _state(o):
+                return (
+                    getattr(o, "capture_aux_hidden_states", "n/a"),
+                    len(getattr(o, "layers_to_capture", []) or []),
+                    sum(1 for _l in (getattr(o, "layers", []) or [])
+                        if getattr(_l, "_is_layer_to_capture", False)),
+                )
+
+            def _purge():
+                n = 0
+                for o in chain:
+                    for _l in (getattr(o, "layers", []) or []):
+                        if getattr(_l, "_is_layer_to_capture", False):
+                            try:
+                                delattr(_l, "_is_layer_to_capture")
+                            except Exception:
+                                setattr(_l, "_is_layer_to_capture", False)
+                            n += 1
+                return n
+
+            # ---- 【關鍵】neural 演算法決定 aux 政策 ----
+            try:
+                from sglang.srt.speculative.hybrid_controller import (
+                    _neural_algo,
+                )
+                _na = _neural_algo()
+            except Exception:
+                _na = "DFLASH"
+            _wants_aux = _na in ("DFLASH", "DSPARK", "EAGLE3")   # EAGLE/MTP 唔要 aux
+            if not _wants_aux:
+                # 關鍵：前一次 init 可能已將 wrapper flag 設 True，而
+                # 上游從不清除 => MTP 會收到多餘特徵（實測 6 層 30720 vs 期望 2 層）。
+                n_purged = _purge()
+                for _o in chain:
+                    try:
+                        setattr(_o, "capture_aux_hidden_states", False)
+                    except Exception:
+                        pass
+                    try:
+                        setattr(_o, "layers_to_capture", [])   # 或 list
+                    except Exception:
+                        pass
+                logger.error(
+                    "HYBRID-FORCE: neural=%s => aux capture DISABLED "
+                    "(purged %d flags, cleared wrapper flag)", _na, n_purged)
+                return
+            # ---- 以下：neural 需要 aux ----
+            use_eagle = bool(getattr(sac, "eagle_use_aux_hidden_state", False))
+            if _na == "EAGLE3":
+                use_eagle = True
+            use_dflash = bool(getattr(sac, "dflash_use_aux_hidden_state", False))
+            if _na in ("DFLASH", "DSPARK"):
+                use_dflash = True
+            logger.error("HYBRID-FORCE: chain=%s BEFORE=%s eagle=%s dflash=%s",
+                         names, {type(o).__name__: _state(o) for o in chain},
+                         use_eagle, use_dflash)
+            if not (use_eagle or use_dflash):
+                return
+
+            if use_eagle:
+                ids = getattr(sac, "eagle_aux_hidden_state_layer_ids", None) or                     _authoritative_eagle3_layer_ids()
+                if not ids:
+                    logger.error("HYBRID-FORCE: EAGLE3 no aux layer ids; skip")
+                    return
+                ids = [int(i) for i in ids]
+                logger.error("HYBRID-FORCE: EAGLE3 authoritative ids=%s", ids)
+                cleared = _purge()
+                logger.error("HYBRID-FORCE: cleared %d stale flags", cleared)
+                # 最外層 wrapper 設 flag（forward 靠佢拆 tuple）
+                _tgt = next((o for o in chain
+                             if hasattr(o, "set_eagle3_layers_to_capture")), None)
+                if _tgt is None:
+                    logger.error("HYBRID-FORCE: no set_eagle3_layers_to_capture")
+                    return
+                try:
+                    setattr(_tgt, "capture_aux_hidden_states", True)
+                except Exception as e:
+                    logger.warning("HYBRID-FORCE: set wrapper flag failed: %s", e)
+                # 直接以權威 ids 呼叫 inner（繞過 wrapper 唔傳參數嘅問題）
+                _inner = getattr(_tgt, "model", None) or _tgt
+                _setter = getattr(_inner, "set_eagle3_layers_to_capture", None)
+                if _setter is None:
+                    logger.error("HYBRID-FORCE: inner has no set_eagle3_layers_to_capture")
+                    return
+                _setter(ids)
+                # inner flag 亦要 True（部分 forward 路徑會查）
+                try:
+                    setattr(_inner, "capture_aux_hidden_states", True)
+                except Exception:
+                    pass
+                logger.error("HYBRID-FORCE: EAGLE3 AFTER=%s",
+                             {type(o).__name__: _state(o) for o in chain})
+                return
+
+            # ---- DFLASH / DSPARK 契約 ----
+            ids = _authoritative_dflash_target_layer_ids()
+            logger.error("HYBRID-FORCE: DFLASH authoritative ids=%s", list(ids))
+            cleared = _purge()
+            logger.error("HYBRID-FORCE: cleared %d stale flags", cleared)
+            _tgt = next((o for o in chain
+                         if hasattr(o, "set_dflash_layers_to_capture")), None)
+            if _tgt is None:
+                logger.error("HYBRID-FORCE: no set_dflash_layers_to_capture on chain")
+                return
+            _tgt.set_dflash_layers_to_capture(list(ids))
+            logger.error("HYBRID-FORCE: DFLASH AFTER=%s",
+                         {type(o).__name__: _state(o) for o in chain})
+        except Exception as e:
+            logger.error("HYBRID-FORCE failed: %s", e, exc_info=True)
+
+    ModelRunner.init_attention_backends = init_attention_backends
+    ModelRunner._dsh_force_aux_patched = True
