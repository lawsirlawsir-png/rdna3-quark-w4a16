+def patch_draft_quantization_boundary():
+    """【轉換層】修補 target(INT4) 與 draft(bf16) 之間嘅量化協議落差。
+
+    DFlash2 官方 README 嘅 Quick Start 冇 --speculative-draft-model-quantization，
+    因為佢假設 target 係 bf16：draft 繼承 target 量化 = None = 正確。
+    但我哋 target 係 INT4-GPTQ ⇒ draft 繼承到 "gptq"，而 DFlash2 係 bf16 unquant
+    （config.json 冇 quantization_config）⇒ get_quant_config 搵唔到 gptq config。
+
+    呢個唔係算法問題，係組合時嘅協議落差 ⇒ 喺邊界做一次顯式轉換。
+    """
+    try:
+        from sglang.srt.managers.tp_worker import TpModelWorker
+    except Exception as e:
+        logger.warning("HYBRID: cannot import TpModelWorker: %s", e)
+        return False
+    if getattr(TpModelWorker, "_dsh_draft_quant_patched", False):
+        return True
+
+    _orig = TpModelWorker._init_model_config
+
+    def _init_model_config(self):
+        _orig(self)
+        try:
+            if not getattr(self, "is_draft_worker", False):
+                return
+            # 【關鍵】只有 DFLASH 嘅 draft 係 bf16 unquant。
+            # EAGLE/MTP 嘅 draft 通常就係 target 自己（同一個 gptq checkpoint）
+            # 如果照樣設成 None，27B 會以 bf16 載入 => 記憶體爆 / 失敗。
+            try:
+                from sglang.srt.speculative.hybrid_controller import (
+                    _neural_algo,
+                )
+                if _neural_algo() not in ("DFLASH", "DSPARK"):
+                    logger.info(
+                        "HYBRID[轉換層]: neural=%s => keep draft quantization %r",
+                        _neural_algo(), q)
+                    return
+            except Exception:
+                pass
+            mc = getattr(self, "model_config", None)
+            if mc is None:
+                return
+            q = getattr(mc, "quantization", None)
+            if q is None:
+                return
+            # draft 係 bf16 unquant（由 DSH_HYBRID_DRAFT_UNQUANT 控制，預設開）
+            import os as _os
+            if _os.environ.get("DSH_HYBRID_DRAFT_UNQUANT", "1") != "1":
+                return
+            logger.info(
+                "HYBRID[轉換層]: draft quantization %r -> None "
+                "(target=INT4, draft=bf16 unquant)", q)
+            mc.quantization = None
+            try:
+                mc.is_draft_quantization_explicit = False
+            except Exception:
+                pass
+        except Exception as e:
+            logger.warning("HYBRID[轉換層] failed: %s", e)
+
+    TpModelWorker._init_model_config = _init_model_config
+    TpModelWorker._dsh_draft_quant_patched = True
+    logger.info("HYBRID[轉換層]: TpModelWorker._init_model_config patched")
+    return True
+
