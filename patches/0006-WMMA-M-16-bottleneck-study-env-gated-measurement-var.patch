+// DSH 2026-09-13: SFL variant - B fragment built by shfl_xor(16) instead of a
+// b_lds round-trip. Measurement entry only (SGL_WMMA_VARIANT=1616).
+template <typename T>
+void launch_gemm_q4_wmma_16x16_1w_sfl(const T* a, const uint32_t* b_q_weight,
+                                      const uint32_t* b_qzeros,
+                                      const T* b_scales, const int* b_q_perm,
+                                      T* c, int size_m, int size_n, int size_k,
+                                      int groups, int zero_offset,
+                                      cudaStream_t stream,
+                                      float* partials = nullptr,
+                                      int k_split_forced = 0) {
+  const int k_split =
+      (k_split_forced ? k_split_forced : compute_wmma_k_split(size_k));
+  dim3 block(32);
+  dim3 grid((size_n + 15) / 16, (size_m + 15) / 16, k_split);
+  gemm_q4_wmma_kernel_16x16_1w<T, true><<<grid, block, 0, stream>>>(
+      a, b_q_weight, b_qzeros, b_scales, c, size_m, size_n, size_k, groups,
+      zero_offset, b_q_perm, partials);
+}
+
+// DSH 2026-09-13: 16M x 32N, 2 waves per block. Each wave owns a 16N slice with
+// its own accumulator chain (2 independent WMMA chains per block) and both
+// waves read the SAME A rows / K slice. Measurement entry (SGL_WMMA_VARIANT=1632).
+template <typename T>
+void launch_gemm_q4_wmma_16x32_2w(const T* a, const uint32_t* b_q_weight,
+                                  const uint32_t* b_qzeros, const T* b_scales,
+                                  const int* b_q_perm, T* c, int size_m,
+                                  int size_n, int size_k, int groups,
+                                  int zero_offset, cudaStream_t stream,
+                                  float* partials = nullptr,
+                                  int k_split_forced = 0) {
+  const int k_split =
+      (k_split_forced ? k_split_forced : compute_wmma_k_split(size_k));
+  dim3 block(64);
+  dim3 grid((size_n + 31) / 32, (size_m + 15) / 16, k_split);
+  gemm_q4_wmma_kernel_16x16_1w<T, false, 32><<<grid, block, 0, stream>>>(
+      a, b_q_weight, b_qzeros, b_scales, c, size_m, size_n, size_k, groups,
+      zero_offset, b_q_perm, partials);
+}
