+// Both produce WRONG numbers on purpose; timing only.
+template <typename T, int ABL, int NACC = 1, int PF = 0>
+void launch_gemm_q4_wmma_16x16_abl(const T* a, const uint32_t* b_q_weight,
+                                   const uint32_t* b_qzeros, const T* b_scales,
+                                   const int* b_q_perm, T* c, int size_m,
+                                   int size_n, int size_k, int groups,
+                                   int zero_offset, cudaStream_t stream,
+                                   float* partials = nullptr,
+                                   int k_split_forced = 0) {
+  const int k_split =
+      (k_split_forced ? k_split_forced : compute_wmma_k_split(size_k));
+  dim3 block(32);
+  dim3 grid((size_n + 15) / 16, (size_m + 15) / 16, k_split);
+  gemm_q4_wmma_kernel_16x16_1w<T, false, 16, ABL, NACC, PF>
+      <<<grid, block, 0, stream>>>(a, b_q_weight, b_qzeros, b_scales, c, size_m,
+                                   size_n, size_k, groups, zero_offset,
