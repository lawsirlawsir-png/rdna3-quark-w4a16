   V16 b_frag;  // DSH: hoisted for the SFL path
 
   for (int k_tile = k_start; k_tile < k_end; k_tile += 16) {
@@ -796,7 +801,7 @@ __global__ void gemm_q4_wmma_kernel_16x16_1w(
 
