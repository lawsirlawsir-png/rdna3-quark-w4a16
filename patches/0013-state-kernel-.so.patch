+
 // ---------------------------------------------------------------------------
 // 量測專用 launcher：SFL / 16x32_2w / ABL。全部納入 SGL_WMMA_MEASUREMENT_BENCH。
 // 2026-09-13 review 更正：先前只守衛了檔尾的 SGL_WMMA_VARIANT 分派表，這三個
@@ -832,6 +861,265 @@ void launch_gemm_q4_wmma_16x16_1w(const T* a, const uint32_t* b_q_weight,
 // 數值（見 kernel 內 ABL==2 的 z_f * 0.0f）。全部呼叫點都在檔尾受守衛的分派
 // 區塊內，故一併守衛不會斷編譯。
 // ---------------------------------------------------------------------------
+
+// ---------------------------------------------------------------------------
+// P51 (2026-09-13): 4-warp 64x64 結構 —— SGL_WMMA_VARIANT=2300
+// 社區參考：hipfire commit be57d8d (gemm_q8_0_wmma_4w.hip)
+//   "per-block weight reuse from 16x (single-warp 16x16) to 64x (4-warp 64x64)"
+//
+// Block = 128 threads = 4 warps。輸出 tile 64(M) x 16(N)：
+//   所有 4 個 warp 共用同一份 B（16x16 反量化 tile 放 LDS），
+//   各自負責 16 條 M row。B 的全域載入量與現行相同，但服務 4 倍輸出。
+// ---------------------------------------------------------------------------
+template <typename T, int NB = 4>
+__global__ void gemm_q4_wmma_4w_kernel(
+    const T* __restrict__ a, const uint32_t* __restrict__ b_q,
+    const uint32_t* __restrict__ b_qzeros, const T* __restrict__ b_scales,
+    T* __restrict__ c, const int size_m, const int size_n, const int size_k,
+    const int groups, const int zero_offset) {
+  using E = typename WmmaNative<T>::elem;
+  using V16 = typename WmmaNative<T>::v16;
+
+  const int warp = threadIdx.x >> 5;      // 0..NB-1
+  const int lane = threadIdx.x & 31;
+  const int lane_lo = lane & 15;
+  const int lane_hi = lane >> 4;
+
+  const int m_tile = blockIdx.y * (16 * NB) + warp * 16;
+  const int n_tile = blockIdx.x * 16;
+  if (m_tile >= size_m || n_tile >= size_n) return;
+
+  // B tile 放 LDS，4 個 warp 共用
+  __shared__ T b_lds[16][16];
+
+  const int groupsize = size_k / groups;
+  const int my_n = lane_lo;
+  const int my_k_octet = lane_hi;
+
+  v8fp32 c_acc = {0, 0, 0, 0, 0, 0, 0, 0};
+
+  for (int k_tile = 0; k_tile < size_k; k_tile += 16) {
+    // ---- wave 0 負責 dequant B 進 LDS（4 warps 共用）----
+    if (warp == 0) {
+      const int actual_n = n_tile + my_n;
+      if (actual_n < size_n) {
+        const int qk_row = (k_tile / 8) + my_k_octet;
+        const uint32_t qa = b_q[qk_row * size_n + actual_n];
+        const int g = k_tile / groupsize;
+        const int qz_idx = g * (size_n / 8) + actual_n / 8;
+        const int qz_shift = (actual_n & 7) * 4;
+        const uint32_t zero_v =
+            ((b_qzeros[qz_idx] >> qz_shift) & 0xF) + (uint32_t)zero_offset;
+        const T scale_t = b_scales[g * size_n + actual_n];
+        const int k_base = my_k_octet * 8;
+        if constexpr (std::is_same<T, half>::value) {
+          half2 z_prep, y_prep;
+          prep_zero_scale_fp16_precise(zero_v, scale_t, z_prep, y_prep);
+          half2 dq[4];
+          dequant_4bit_8_fp16_precise(qa, dq, z_prep, y_prep);
+          b_lds[k_base + 0][my_n] = __low2half(dq[0]);
+          b_lds[k_base + 1][my_n] = __high2half(dq[0]);
+          b_lds[k_base + 2][my_n] = __low2half(dq[1]);
+          b_lds[k_base + 3][my_n] = __high2half(dq[1]);
+          b_lds[k_base + 4][my_n] = __low2half(dq[2]);
+          b_lds[k_base + 5][my_n] = __high2half(dq[2]);
+          b_lds[k_base + 6][my_n] = __low2half(dq[3]);
+          b_lds[k_base + 7][my_n] = __high2half(dq[3]);
+        } else {
+          float z_f, y_f;
+          prep_zero_scale_bf16_f32(zero_v, scale_t, z_f, y_f);
+          bf162_t dq[4];
+          dequant_4bit_8_bf16_to_bf16(qa, dq, z_f, y_f);
+          b_lds[k_base + 0][my_n] = dq[0].x;
+          b_lds[k_base + 1][my_n] = dq[0].y;
+          b_lds[k_base + 2][my_n] = dq[1].x;
+          b_lds[k_base + 3][my_n] = dq[1].y;
+          b_lds[k_base + 4][my_n] = dq[2].x;
+          b_lds[k_base + 5][my_n] = dq[2].y;
+          b_lds[k_base + 6][my_n] = dq[3].x;
+          b_lds[k_base + 7][my_n] = dq[3].y;
+        }
+      }
+    }
+    __syncthreads();
+
+    // ---- 4 個 warp 各自讀同一份 B tile、用自己的 A rows ----
+    V16 b_frag;
+#pragma unroll
+    for (int i = 0; i < 16; ++i) b_frag[i] = bitcast_elem<T, E>(b_lds[i][lane_lo]);
+
+    V16 a_frag;
+    if (m_tile + (lane & 15) < size_m) {
+      __builtin_memcpy(&a_frag, a + (long)(m_tile + lane_lo) * size_k + k_tile,
+                       sizeof(a_frag));
+    } else {
+#pragma unroll
+      for (int i = 0; i < 16; ++i) a_frag[i] = (E)0;
+    }
+    c_acc = wmma_mma(a_frag, b_frag, c_acc);
+    __syncthreads();
+  }
+
+  // ---- epilogue ----
+  const int out_n = n_tile + lane_lo;
+  if (out_n < size_n) {
+#pragma unroll
+    for (int i = 0; i < 8; i++) {
+      const int out_m = m_tile + 2 * i + lane_hi;
+      if (out_m < size_m) {
+        if constexpr (std::is_same<T, half>::value) {
+          c[out_m * size_n + out_n] = __float2half_rn(c_acc[i]);
+        } else {
+          c[out_m * size_n + out_n] = __float2bfloat16(c_acc[i]);
+        }
+      }
+    }
+  }
+}
+
+
+// ---------------------------------------------------------------------------
+// P60 (2026-09-13): iu4 + 64x64_4w + 無 LDS  —— SGL_WMMA_VARIANT=2400
+//
+// 組合動機：
+//   官方 iu4 mapping 顯示 B[k][j] 落喺 lane j 的 GPR floor(k/8)，
+//   而 GPTQ 的 b_q[row][n] 每個 int32 正好是 8 個連續 K 的 nibble
+//   ⇒ b_q[k/8][n] 本身就是 iu4 的 B fragment。
+//   ⇒ 同時消除：16 次 LDS 讀/寫、bf16 反量化、跨 lane 移動。
+//
+// 代價：iu4 是整數累加器，scale（per (group,n)）必須每 group 事後乘入。
+// ---------------------------------------------------------------------------
+#ifdef SGL_WMMA_MEASUREMENT_BENCH  // P60: 量測專用 kernel
+template <typename T, bool NO_LOAD = false, bool NO_MMA = false, bool NO_VALU = false>
+__global__ void gemm_q4_wmma_iu4_nolds_kernel(
+    const T* __restrict__ a, const uint32_t* __restrict__ b_q,
+    const T* __restrict__ b_scales, T* __restrict__ c, const int size_m,
+    const int size_n, const int size_k, const int groups) {
+  using v2i = int32_t __attribute__((ext_vector_type(2)));
+  using v8i = int32_t __attribute__((ext_vector_type(8)));
+
+  const int wave_id = threadIdx.x >> 5;   // 0..3
+  const int lane = threadIdx.x & 31;
+  const int lane_lo = lane & 15;
+  const int lane_hi = lane >> 4;
+
+  const int n_tile = blockIdx.x * 64;
+  const int m_tile = blockIdx.y * 16;
+  if (m_tile >= size_m || n_tile >= size_n) return;
+
+  // wave w 負責 n ∈ [n_tile + 16w, +16)
+  const int n_wave = n_tile + wave_id * 16;
+  const int n = n_wave + lane_lo;           // 本 lane 負責的輸出欄
+  if (n >= size_n) return;
+
+  const int groupsize = size_k / groups;
+
+  // ---- A fragment：lane_lo = i (0..15)，lane_hi 提供 k/8 的另一半 ----
