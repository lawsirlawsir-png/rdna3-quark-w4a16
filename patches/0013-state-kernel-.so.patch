+  static_assert(!(PF == 1 && MT > 1), "PF only defined for MT==1");
   const int pf_actual_n = n_tile + lane_lo;
   const int pf_qz_shift = (pf_actual_n & 7) * 4;
   uint32_t pf_qa = 0, pf_zq = 0;
