+    const int row_base = kt * 2;   // (kt*16)/8
+    v2i b_frag;
+    if constexpr (NO_LOAD) {
+      b_frag[0] = (int32_t)(row_base + 0);
+      b_frag[1] = (int32_t)(row_base + 1);
+    } else {
+      b_frag[0] = (int32_t)b_q[(size_t)(row_base + 0) * size_n + n];
+      b_frag[1] = (int32_t)b_q[(size_t)(row_base + 1) * size_n + n];
+    }
+
+    if constexpr (NO_MMA) {
+      // 保留一個便宜的消費，避免整段被優化掉
+      c_int[0] += b_frag[0] & 1;
+      c_int[1] += b_frag[1] & 1;
