+// P31: MT=4 -> 128-thread block, 4 個獨立 16x16 tile（每 wave 一個）。
+// 目的：把「每 CU 最多 16 個 block」的排程鉗子放寬 4 倍。
+template <typename T>
+void launch_gemm_q4_wmma_16x16_4t(const T* a, const uint32_t* b_q_weight,
+                                  const uint32_t* b_qzeros, const T* b_scales,
+                                  const int* b_q_perm, T* c, int size_m,
+                                  int size_n, int size_k, int groups,
+                                  int zero_offset, cudaStream_t stream,
+                                  float* partials = nullptr,
+                                  int k_split_forced = 0) {
+  const int k_split =
+      (k_split_forced ? k_split_forced : compute_wmma_k_split_mn(size_m, size_n, size_k, 16, 64));
+  dim3 block(128);
+  dim3 grid((size_n + 63) / 64, (size_m + 15) / 16, k_split);
+  gemm_q4_wmma_kernel_16x16_1w<T, false, 16, 0, 1, 0, 4>
+      <<<grid, block, 0, stream>>>(a, b_q_weight, b_qzeros, b_scales, c,
+                                   size_m, size_n, size_k, groups, zero_offset,
+                                   b_q_perm, partials);
+}
