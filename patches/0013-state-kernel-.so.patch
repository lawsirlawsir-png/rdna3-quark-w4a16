+         只在迴圈結束後折入 fp32 一次。 */
+    } else if ((kt % kt_per_grp) == (kt_per_grp - 1)) {
+      const int g = kt / kt_per_grp;
+      const float s = (float)b_scales[(size_t)g * size_n + n];
+#pragma unroll
+      for (int i = 0; i < 8; ++i) acc[i] += (float)c_int[i] * s;
+      c_int = (v8i){0, 0, 0, 0, 0, 0, 0, 0};
+    }
+  }
+  if constexpr (NO_VALU) {
+    const float s = (float)b_scales[(size_t)0 * size_n + n];
+#pragma unroll
+    for (int i = 0; i < 8; ++i) acc[i] = (float)c_int[i] * s;
+  }
+  // 尾數（size_k 不是 groupsize 整數倍時，理論上不會發生）
+  if ((kt_count % kt_per_grp) != 0) {
+    const int g = groups - 1;
+    const float s = (float)b_scales[(size_t)g * size_n + n];
+#pragma unroll
+    for (int i = 0; i < 8; ++i) acc[i] += (float)c_int[i] * s;
+  }
+
+  // ---- 輸出 ----
+  // D[i][j] 落喺 lane ((16*i)%32)+j → 本 wave 的 lane_lo = n 偏移、lane_hi 決定 i 的奇偶
+  const int m_out = m_tile + 2 * 0 + lane_hi;   // 佔位，實際見下
+#pragma unroll
+  for (int i = 0; i < 8; ++i) {
+    const int m = m_tile + 2 * i + lane_hi;
+    if (m < size_m) {
+      c[(size_t)m * size_n + n] = (T)acc[i];
+    }
+  }
+  (void)m_out;
+}
