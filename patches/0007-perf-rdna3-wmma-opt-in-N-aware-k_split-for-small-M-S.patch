From 0d2e013727af7f51e409630fcc662b0fd31bda6c Mon Sep 17 00:00:00 2001
From: lawsir <lawsir@mac-mini-hermes>
Date: Sun, 13 Sep 2026 03:02:29 +0800
Subject: [PATCH 07/19] perf(rdna3-wmma): opt-in N-aware k_split for small-M
 (SGL_WMMA_KSPLIT_AUTO=1); -7.9% on M=16 verify GEMM across all 6 production
 shapes, fp64-identical accuracy; default path unchanged

---
 .../aot/csrc/gemm/gptq/q_gemm_rdna3_wmma.cu   | 40 ++++++++++++++++++-
 .../aot/csrc/gemm/gptq/q_gemm_rdna3_wmma.hip  | 40 ++++++++++++++++++-
 2 files changed, 78 insertions(+), 2 deletions(-)

diff --git a/python/sglang/kernels/aot/csrc/gemm/gptq/q_gemm_rdna3_wmma.cu b/python/sglang/kernels/aot/csrc/gemm/gptq/q_gemm_rdna3_wmma.cu
index 0663887..9b3cff2 100644
--- a/python/sglang/kernels/aot/csrc/gemm/gptq/q_gemm_rdna3_wmma.cu
+++ b/python/sglang/kernels/aot/csrc/gemm/gptq/q_gemm_rdna3_wmma.cu
@@ -244,6 +244,37 @@ __host__ __device__ static inline int compute_wmma_k_split(int size_k) {
   return 1;
 }
 
+// DSH 2026-09-13: N-aware K-split for the small-M regime (16x16_1w).
+//
+// compute_wmma_k_split() above is K-only, so every K in {5120, 6144, 17408}
+// returns 4 regardless of N. Measured on gfx1100 at M=16 over all six
+// production shapes, the optimum is the smallest split that brings the block
+// count to >= ~5120:
+//
+//   shape            base=N/16  k=4      k=8      k=16     k=32     best
+//   5120 x 17408     1088       0.22503  0.22087  0.22612  0.25149  k=8
+//   17408 x 5120      320       0.26621  0.26696  0.22434  0.22263  k=16
+//   5120 x 10240      640       0.16138  0.13935  0.14128  0.15573  k=8
+//   6144 x 5120       320       0.10095  0.10367  0.09191  0.09835  k=16
+//   5120 x 6144       384       0.09661  0.09436  0.09122  0.09996  k=16
+//   5120 x 12288      768       0.17250  0.16021  0.16392  0.18090  k=8
+//
+// The rule below picks the measured optimum in 6/6 shapes. Weighted by the
+// real layer mix (per-layer ms x layer count) it takes the M=16 verify GEMM
+// from 67.45 ms to 62.14 ms, i.e. -7.9%.
+//
+// Opt-in only (SGL_WMMA_KSPLIT_AUTO=1); the default path is untouched.
+__host__ __device__ static inline int choose_k_split_small_m(int size_m,
+                                                             int size_n,
+                                                             int size_k) {
+  const int base = ((size_n + 15) / 16) * ((size_m + 15) / 16);
+  constexpr int kTargetBlocks = 5120;
+  int k = 1;
+  while (k < 256 && base * k < kTargetBlocks) k <<= 1;
+  while (k > 1 && (size_k % (k * 16)) != 0) k >>= 1;
+  return k;
+}
+
 // M-and-N-aware K-split heuristic for the v3/v4/v5 launchers.
 //
 // The original `compute_wmma_k_split` was K-only and always returns 4 for
@@ -2581,10 +2612,17 @@ void launch_gemm_q4_wmma_deterministic(
     const char* e = ::getenv("SGL_WMMA_KSPLIT");
     return e ? ::atoi(e) : 0;
   }();
+  static const bool sgl_ksplit_auto = []() {
+    const char* e = ::getenv("SGL_WMMA_KSPLIT_AUTO");
+    return e != nullptr && e[0] == '1';
+  }();
   const int k_split =
       (sgl_ksplit > 0)
           ? sgl_ksplit
-          : wmma_natural_k_split(size_m, size_n, size_k, b_q_perm != nullptr);
+          : (sgl_ksplit_auto
+                 ? choose_k_split_small_m(size_m, size_n, size_k)
+                 : wmma_natural_k_split(size_m, size_n, size_k,
+                                        b_q_perm != nullptr));
 
   if (k_split == 1) {
     // No split-K: the direct-store epilogue already has exactly one writer
