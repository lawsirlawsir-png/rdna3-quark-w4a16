-__host__ __device__ static inline int choose_k_split_small_m(int size_m,
-                                                             int size_n,
-                                                             int size_k) {
-  const int base = ((size_n + 15) / 16) * ((size_m + 15) / 16);
-  constexpr int kTargetBlocks = 5120;
-  int k = 1;
-  while (k < 256 && base * k < kTargetBlocks) k <<= 1;
-  while (k > 1 && (size_k % (k * 16)) != 0) k >>= 1;
-  return k;
