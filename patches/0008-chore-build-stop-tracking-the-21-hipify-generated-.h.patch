-// Find the min val of div2 that doesn't increase N/(div1*div2)
-int mindiv(int N, int div1, int div2) {
-  int nPrRnd = div1 * div2;
-  int rnds[13];
-  for (int i = 0; i < 13; i++) {
-    rnds[i] = (N + nPrRnd - 1) / nPrRnd;
-    nPrRnd -= div1;
-  }
-  for (int i = 12; i >= 0; i--)
-    if (rnds[0] == rnds[i]) return (div2 - i);
-  return 0;
-}
