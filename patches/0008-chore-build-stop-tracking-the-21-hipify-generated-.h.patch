-__global__ void transfer_page_head_kernel_impl(
-    const void* __restrict__ src_k,
-    void* __restrict__ dst_k,
-    const void* __restrict__ src_v,
-    void* __restrict__ dst_v,
-    const int64_t* __restrict__ src_indices,
