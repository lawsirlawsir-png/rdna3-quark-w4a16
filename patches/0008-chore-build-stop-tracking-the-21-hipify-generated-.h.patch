-template <typename T, int M_COUNT>
-void launch_gemm_q4_for_mcount(const T* a, const uint32_t* b_q_weight,
-                               const uint32_t* b_qzeros, const T* b_scales,
-                               const int* b_q_perm, T* c, int size_m,
-                               int size_n, int size_k, int groups,
-                               int zero_offset, float* partials,
-                               hipStream_t stream) {
-  dim3 block(THREADS_X);
-  dim3 grid((size_n + BLOCK_KN_SIZE * 4 - 1) / (BLOCK_KN_SIZE * 4),
-            (size_m + M_COUNT - 1) / M_COUNT,
-            (size_k + BLOCK_KN_SIZE - 1) / BLOCK_KN_SIZE);
-
-  const int b2_gs = size_k / groups;
-  const bool b2_ok = (b2_gs >= 32) && (b2_gs <= BLOCK_KN_SIZE) &&
-                     ((BLOCK_KN_SIZE % b2_gs) == 0);
-  if constexpr (std::is_same<T, __hip_bfloat16>::value && (M_COUNT > 1)) {
-    if (b2_ok) {
-     hipLaunchKernelGGL(( gemm_q4_kernel_rdna3<T, M_COUNT, true>), dim3(grid), dim3(block), 0, stream, 
-          a, b_q_weight, b_qzeros, b_scales, c, size_m, size_n, size_k, groups,
-          zero_offset, b_q_perm, partials);
-      return;
-    }
-  }
- hipLaunchKernelGGL(( gemm_q4_kernel_rdna3<T, M_COUNT, false>), dim3(grid), dim3(block), 0, stream, 
-      a, b_q_weight, b_qzeros, b_scales, c, size_m, size_n, size_k, groups,
-      zero_offset, b_q_perm, partials);
