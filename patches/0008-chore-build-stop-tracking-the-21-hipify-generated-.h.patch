-      b_frag[i] = bitcast_elem<T, E>(b_lds[cur_buf][i][lane_lo]);
-    }
-
-    // Each wave issues its own WMMA against its own a_frag + shared b_frag.
-    // 4 wmmas in flight per block per K-iter.
-    c_acc = wmma_mma(a_frag, b_frag, c_acc);
-
-    __syncthreads();
-    cur_buf = next_buf;
