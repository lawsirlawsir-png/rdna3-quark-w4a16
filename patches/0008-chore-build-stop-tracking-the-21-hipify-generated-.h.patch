-  const auto run_cumsum = [&] {
-#pragma unroll 8
-    for (int32_t i = 0; i < 8; ++i) {
-      static_assert(1 << 8 == RADIX);
-      if (tx < RADIX) {
-        const auto j = 1 << i;
