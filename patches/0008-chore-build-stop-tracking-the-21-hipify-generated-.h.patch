-// ---------------------------------------------------------------------------
-// Deterministic split-K epilogue (port of vLLM PR #54706, mirroring the
-// scalar path in q_gemm_rdna3.cu).
-//
-// Splitting K across gridDim.z makes several blocks accumulate into the same
-// output cell. The CAS epilogue resolves that by ADDING in whatever order the
-// blocks land, and bf16/fp16 addition is not associative, so the result
-// depends on scheduling. Instead each split block writes its FP32 partial to
-// a scratch plane indexed by blockIdx.z, and one fixed reduce pass sums the
-// planes in ascending-z order with a single final cast.
-//
-// Every kernel writes each in-range (z, m, n) cell exactly once, so the
-// scratch can be at::empty (no zero-fill).
-// ---------------------------------------------------------------------------
-template <typename T>
-__global__ void reduce_partials_rdna3_wmma(const float* __restrict__ partials,
-                                           T* __restrict__ c,
-                                           const int z_count, const int size_m,
-                                           const int size_n) {
-  const long idx = (long)blockIdx.x * blockDim.x + threadIdx.x;
-  if (idx >= (long)size_m * size_n) return;
-  const int m = (int)(idx / size_n);
-  const int n = (int)(idx % size_n);
-  float acc = 0.0f;
-  for (int z = 0; z < z_count; ++z)
-    acc += partials[((long)z * size_m + m) * size_n + n];
-  if constexpr (std::is_same<T, half>::value) {
-    c[idx] = __float2half_rn(acc);
-  } else {
-    c[idx] = __float2bfloat16(acc);
-  }
-}
-
-// Deterministic WMMA GEMM entry point.
-//
-// TILE_M = 128 keeps the scratch at [k_split, 128, size_n] fp32 (35.6 MB for
-// M=2048 / K=5120 / N=17408) while still letting every full chunk take the
-// 128x64_k32 / 128x64_k16 prefill kernels (M >= 128).
-//
-// gridDim.z is forced to the K-ONLY split factor for every chunk. That is
-// deliberate: compute_wmma_k_split_mn() is NOT monotonic in size_m -- a small
-// M falls through its block-count thresholds to the K-only heuristic and can
-// request a LARGER split than a large M does (m=128 -> 4, m=2048 -> 1 for
-// K=5120/N=17408). Recomputing per chunk would let gridDim.z disagree with the
-// reduce pass's z_count and silently read never-written scratch.
-// compute_wmma_k_split(size_k) depends on size_k alone, so every chunk agrees.
-// Mirrors the dispatch in launch_gemm_q4_wmma_64x64_4w() and its fallback
-// chain, returning the K-split the FULL shape would use. It is used only to
-// size the deterministic scratch; the value is then FORCED on every launch,
-// so a disagreement can never desynchronise gridDim.z from the reduce pass.
-// A wrong answer here costs performance, never correctness: k_split == 1
-// simply disables split-K, which is always numerically correct.
-__host__ static inline int wmma_natural_k_split(int size_m, int size_n,
-                                                int size_k, bool has_perm) {
-  if (size_m >= 64) {
-    if (size_n < 32) return compute_wmma_k_split_mn(size_m, size_n, size_k, 64, 16);
-    if (size_n < 64) return compute_wmma_k_split_mn(size_m, size_n, size_k, 64, 32);
-    if (size_m >= 128 && !has_perm)
-      return compute_wmma_k_split_mn(size_m, size_n, size_k, 128, 64);
-    return compute_wmma_k_split_mn(size_m, size_n, size_k, 64, 64);
-  }
-  // 16x16_1w and 32x16_2w both use the K-only heuristic.
-  return compute_wmma_k_split(size_k);
-}
-
-template <typename T>
-void launch_gemm_q4_wmma_deterministic(
-    const T* a, const uint32_t* b_q_weight, const uint32_t* b_qzeros,
-    const T* b_scales, const int* b_q_perm, T* c, int size_m, int size_n,
-    int size_k, int groups, int zero_offset, hipStream_t stream) {
-  constexpr long kMaxScratchBytes = 256L << 20;
-  constexpr int TILE_M = 128;
-
-  // DSH 2026-09-13: SGL_WMMA_KSPLIT override for the grid-parallelism sweep.
-  static const int sgl_ksplit = []() {
-    const char* e = ::getenv("SGL_WMMA_KSPLIT");
-    return e ? ::atoi(e) : 0;
-  }();
-  static const bool sgl_ksplit_auto = []() {
-    const char* e = ::getenv("SGL_WMMA_KSPLIT_AUTO");
-    return e != nullptr && e[0] == '1';
-  }();
-  const int k_split =
-      (sgl_ksplit > 0)
-          ? sgl_ksplit
-          : (sgl_ksplit_auto
-                 ? choose_k_split_small_m(size_m, size_n, size_k)
-                 : wmma_natural_k_split(size_m, size_n, size_k,
-                                        b_q_perm != nullptr));
-
-  if (k_split == 1) {
-    // No split-K: the direct-store epilogue already has exactly one writer
-    // per cell, so there is nothing to make deterministic and no scratch to
-    // allocate. This is the prefill regime (M >= 128, large N), so the
-    // deterministic path costs nothing there.
-    launch_gemm_q4_wmma_64x64_4w<T>(a, b_q_weight, b_qzeros, b_scales, b_q_perm,
-                                    c, size_m, size_n, size_k, groups,
-                                    zero_offset, stream, /*partials=*/nullptr,
-                                    /*k_split_forced=*/1);
-    return;
-  }
-
-  // k_split > 1 only when the no-split grid is under-subscribed, i.e. when
-  // size_m is small (or N is small), so [k_split, size_m, size_n] fp32 stays
-  // well inside the budget. The guard falls back to 128-row chunking for any
-  // pathological shape, forcing the SAME k_split on every chunk so that
-  // gridDim.z and the reduce pass can never disagree.
-  const long scratch_bytes = (long)k_split * size_m * size_n * 4;
-  const int chunk_m = (scratch_bytes <= kMaxScratchBytes) ? size_m : TILE_M;
-  const int alloc_m = (chunk_m < size_m) ? chunk_m : size_m;
-
-  at::Tensor partials =
-      at::empty({k_split, alloc_m, size_n},
-                at::TensorOptions().dtype(at::kFloat).device(at::kCUDA));
-  float* partials_ptr = partials.data_ptr<float>();
-
-  for (int row0 = 0; row0 < size_m; row0 += chunk_m) {
-    const int rows = (chunk_m < size_m - row0) ? chunk_m : (size_m - row0);
-    launch_gemm_q4_wmma_64x64_4w<T>(
-        a + (long)row0 * size_k, b_q_weight, b_qzeros, b_scales, b_q_perm,
-        c + (long)row0 * size_n, rows, size_n, size_k, groups, zero_offset,
-        stream, partials_ptr, k_split);
-    const long total = (long)rows * size_n;
-    const int threads = 256;
