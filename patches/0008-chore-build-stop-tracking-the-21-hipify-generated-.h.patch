-    // but stored as FP32 (no packed atomic, no CAS).
-    const int out_n = n_tile + lane_lo;
-    if (out_n < size_n) {
-  #pragma unroll
-      for (int i = 0; i < 8; i++) {
-        const int out_m = m_tile_wave + 2 * i + lane_hi;
-        if (out_m < size_m)
-          partials[((long)blockIdx.z * size_m + out_m) * size_n + out_n] =
