-                     __N)                                                   \
-      else                                                                  \
-        WVSPLITK_CFG(/*THRDS=*/32, /*WVPRGRP=*/16, /*YTILE=*/1, /*UNRL=*/1, \
-                     __N)                                                   \
-    } else if (on_gfx1x()) { /* gfx1100/gfx1150/GFX12, wave32 */            \
