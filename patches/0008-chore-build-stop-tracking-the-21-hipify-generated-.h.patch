-  const int num_tokens = static_cast<int>(gating_output.size(0));
-  const int topk = static_cast<int>(topk_weights.size(-1));
-
-  const bool is_pow_2 = (num_experts != 0) && ((num_experts & (num_experts - 1)) == 0);
