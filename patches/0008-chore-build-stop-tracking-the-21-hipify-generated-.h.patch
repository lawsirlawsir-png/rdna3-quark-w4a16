-//   5120 x 17408     1088       0.22503  0.22087  0.22612  0.25149  k=8
-//   17408 x 5120      320       0.26621  0.26696  0.22434  0.22263  k=16
-//   5120 x 10240      640       0.16138  0.13935  0.14128  0.15573  k=8
-//   6144 x 5120       320       0.10095  0.10367  0.09191  0.09835  k=16
-//   5120 x 6144       384       0.09661  0.09436  0.09122  0.09996  k=16
-//   5120 x 12288      768       0.17250  0.16021  0.16392  0.18090  k=8
